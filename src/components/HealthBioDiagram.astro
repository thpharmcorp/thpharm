---
// 질환별 "몸에서는 무슨 일이 일어날까?" 30초 이해용 자체 제작 도식 (기획안 §18.3 항목 02)
// 실제 의학 Figure 복제가 아닌 THPHARM 자체 편집 도식. 색상은 질환별 accent에 맞춤.
interface Props {
  slug: 'obesity' | 'diabetes' | 'hypertension' | 'mash' | string;
  accent: string; // hex, 예: #EE7F1A
}
const { slug, accent } = Astro.props;
---

<div class="mx-auto w-full max-w-[280px]">
  {
    slug === 'obesity' && (
      <svg viewBox="0 0 220 160" class="h-auto w-full" aria-hidden="true">
        <circle cx="70" cy="80" r="26" fill={`${accent}22`} stroke={accent} stroke-width="2" />
        <circle cx="115" cy="60" r="34" fill={`${accent}33`} stroke={accent} stroke-width="2" />
        <circle cx="160" cy="90" r="22" fill={`${accent}22`} stroke={accent} stroke-width="2" />
        <circle cx="115" cy="60" r="10" fill={accent} opacity="0.5" />
        <path d="M40,130 L180,130" stroke="#00000015" stroke-width="10" stroke-linecap="round" />
        <text x="110" y="150" text-anchor="middle" font-size="9" fill="#00000055">지방세포 비대 · 만성 염증</text>
      </svg>
    )
  }
  {
    slug === 'diabetes' && (
      <svg viewBox="0 0 220 160" class="h-auto w-full" aria-hidden="true">
        <rect x="20" y="55" width="46" height="34" rx="10" fill={`${accent}22`} stroke={accent} stroke-width="2" />
        <text x="43" y="76" text-anchor="middle" font-size="8" fill={accent} font-weight="700">췌장</text>
        <path d="M68,72 L110,72" stroke={accent} stroke-width="2" marker-end="url(#arrow)" />
        <circle cx="130" cy="72" r="4" fill={accent} />
        <circle cx="142" cy="64" r="4" fill={accent} />
        <circle cx="142" cy="82" r="4" fill={accent} />
        <circle cx="118" cy="60" r="4" fill={accent} />
        <rect x="160" y="45" width="44" height="60" rx="8" fill="none" stroke="#00000030" stroke-width="2" />
        <text x="182" y="130" text-anchor="middle" font-size="8" fill="#00000055">세포 (인슐린 저항성)</text>
        <defs>
          <marker id="arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto">
            <path d="M0,0 L6,3 L0,6 Z" fill={accent} />
          </marker>
        </defs>
      </svg>
    )
  }
  {
    slug === 'hypertension' && (
      <svg viewBox="0 0 220 160" class="h-auto w-full" aria-hidden="true">
        <path
          d="M60,70 C60,50 90,50 100,68 C110,50 140,50 140,70 C140,95 100,120 100,120 C100,120 60,95 60,70 Z"
          fill={`${accent}22`}
          stroke={accent}
          stroke-width="2.5"
        />
        <path d="M20,72 L60,72 L70,55 L82,90 L92,72 L200,72" fill="none" stroke={accent} stroke-width="2" />
        <text x="110" y="145" text-anchor="middle" font-size="9" fill="#00000055">혈관벽 압력 상승</text>
      </svg>
    )
  }
  {
    slug === 'mash' && (
      <svg viewBox="0 0 220 160" class="h-auto w-full" aria-hidden="true">
        <path
          d="M40,50 C70,30 130,30 165,55 C185,70 180,105 150,115 C120,125 60,120 45,100 C30,82 25,65 40,50 Z"
          fill={`${accent}22`}
          stroke={accent}
          stroke-width="2.5"
        />
        <circle cx="80" cy="70" r="4" fill={accent} opacity="0.7" />
        <circle cx="100" cy="85" r="4" fill={accent} opacity="0.7" />
        <circle cx="120" cy="65" r="4" fill={accent} opacity="0.7" />
        <circle cx="135" cy="90" r="4" fill={accent} opacity="0.7" />
        <circle cx="95" cy="55" r="4" fill={accent} opacity="0.7" />
        <text x="110" y="145" text-anchor="middle" font-size="9" fill="#00000055">간 지방 축적 · 염증</text>
      </svg>
    )
  }
</div>
