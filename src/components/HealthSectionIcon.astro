---
interface Props {
  kind:
    | 'summary'
    | 'body'
    | 'risk'
    | 'treatment'
    | 'trend'
    | 'doctor'
    | 'myth'
    | 'obesity'
    | 'diabetes'
    | 'hypertension'
    | 'mash'
    // 2026-08-25: HEALTH 메뉴 확장(Tier 2 종합 건강정보) — 카테고리 카드(skin/hair)와
    // 경량 콘텐츠 섹션(cause/symptoms/selfcare) 아이콘 추가.
    | 'skin'
    | 'hair'
    | 'cause'
    | 'symptoms'
    | 'selfcare';
  class?: string;
}
const { kind, class: cls = 'h-5 w-5' } = Astro.props;
---

{kind === 'summary' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" />
    <path d="M12 8v0.01M12 11v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
)}
{kind === 'body' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <circle cx="12" cy="5" r="2.4" stroke="currentColor" stroke-width="1.8" />
    <path d="M6 21v-5l2-6h8l2 6v5M9 10v11M15 10v11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{kind === 'risk' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <rect x="5" y="4" width="14" height="17" rx="2" stroke="currentColor" stroke-width="1.8" />
    <path d="M9 3.5h6v2H9z" fill="currentColor" />
    <path d="M8.5 12.5l2 2 4-4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{kind === 'treatment' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <rect x="3.5" y="9.5" width="17" height="7" rx="3.5" transform="rotate(-45 12 13)" stroke="currentColor" stroke-width="1.8" />
    <path d="M9.5 13.5l4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
)}
{kind === 'trend' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M4 16l5-6 4 4 7-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M15 5h5v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{kind === 'doctor' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <circle cx="12" cy="7" r="3" stroke="currentColor" stroke-width="1.8" />
    <path d="M5 21c0-4 3-6 7-6s7 2 7 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    <path d="M9.5 21v-3M14.5 21v-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  </svg>
)}
{kind === 'myth' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    <path d="M12 8v5m0 3v.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
  </svg>
)}
{kind === 'obesity' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <circle cx="12" cy="4.2" r="1.7" stroke="currentColor" stroke-width="1.7" />
    <path d="M4.5 19.5c0-4.5 3.2-8 7.5-8s7.5 3.5 7.5 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
    <path d="M4.5 19.5h15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
  </svg>
)}
{kind === 'diabetes' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M12 3c3 4 6 7.4 6 10.8a6 6 0 11-12 0C6 10.4 9 7 12 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
    <path d="M9.5 14.5l1.8-2 1.7 2 1.8-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{kind === 'hypertension' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M12 20s-7.4-4.5-9.4-9.2A5 5 0 0112 5.6a5 5 0 019.4 5.2C19.4 15.5 12 20 12 20z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    <path d="M3.5 12h4l1.5-3 2 5 1.5-3h7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{kind === 'mash' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path
      d="M4.2 13.2c-.3-3.8 2.8-7.6 7.4-7.6 3.6 0 6.3 1.8 7.4 4.5.9 2.1-.3 3.8-1.9 3.8-1 0-1.6-1-2.6-1s-1.6 1.3-3 1.3-1.7-1.1-3-1.1-2.2 1.9-3.6 1.9c-.9 0-1.6-.6-1.7-1.8z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
  </svg>
)}
{kind === 'skin' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M12 3.5c4 3 6.5 6.4 6.5 9.8a6.5 6.5 0 11-13 0c0-3.4 2.5-6.8 6.5-9.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    <circle cx="10" cy="14" r="1" fill="currentColor" />
    <circle cx="13.5" cy="16" r="0.9" fill="currentColor" />
  </svg>
)}
{kind === 'hair' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M6 21c-1-4 0-7 1-9M9.5 21c-.8-4.5 0-8 1-10.5M12.5 21c-.6-5 0-9 .5-11.5M16 21c-.3-5 .5-9.5 1.5-12M19.5 21c0-5 1-9.5 2-12.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
)}
{kind === 'cause' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.7" />
    <path d="M15.7 15.7L20 20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
  </svg>
)}
{kind === 'symptoms' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M3.5 13h3l2-5 3 9 2.5-7 1.5 3h4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{kind === 'selfcare' && (
  <svg viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
    <path d="M12 20.5s-7-4.2-7-9.8a4.4 4.4 0 017-3.4 4.4 4.4 0 017 3.4c0 5.6-7 9.8-7 9.8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
    <path d="M9.5 11.2l1.6 1.6 3-3.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
