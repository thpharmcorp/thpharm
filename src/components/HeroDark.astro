---
// 2026-08-21: 페이지마다 다른 내용인데도 전부 같은 세포 이미지 + 같은 3개 배지(ORAL/BIO-AI/
// METABOLIC)를 재활용하고 있어 "메뉴를 넘어가도 시각적으로 구분이 안 된다"는 피드백을 받았다.
// 홈페이지에 적용했던 방식(사진 없이, 큼직한 타이포그래피 + 페이지별 실제 키워드로 만든
// 워드클라우드 텍스처)을 이 공용 히어로에도 그대로 확장 — 세포 이미지·고정 배지 3종·분자
// 네트워크 SVG 배경을 모두 제거하고, 페이지마다 다른 wordCloud를 전달받아 배경에 깐다.
// slot="visual"은 앞으로 정말 페이지 전용 비주얼이 필요할 때를 위해 탈출구로만 남겨둔다
// (2026-08-21 기준 실제로 쓰는 페이지는 없음).
interface WordCloudItem {
  text: string;
  top: string;
  left: string;
  size: string; // Tailwind 폰트 크기 클래스, 예: 'text-xl md:text-2xl'
  rotate: number;
  opacity: number;
  accent?: boolean;
}
interface Props {
  eyebrow: string;
  title: string;
  accent?: string; // 타이틀 중 강조할 마지막 구절(선택)
  body: string;
  ctaPrimaryLabel?: string;
  ctaPrimaryHref?: string;
  ctaSecondaryLabel?: string;
  ctaSecondaryHref?: string;
  tags?: string[];
  /** 히어로 배경에 깔 페이지별 키워드 텍스처 — 없으면 텍스처 없이 라디얼 글로우만 표시 */
  wordCloud?: WordCloudItem[];
}
const {
  eyebrow,
  title,
  accent,
  body,
  ctaPrimaryLabel,
  ctaPrimaryHref,
  ctaSecondaryLabel,
  ctaSecondaryHref,
  tags = [],
  wordCloud = [],
} = Astro.props;

const titleMain = accent && title.endsWith(accent) ? title.slice(0, -accent.length) : title;
const hasVisualSlot = Astro.slots.has('visual');
---

<section class="relative overflow-hidden bg-thp-navy text-white">
  <!-- 라디얼 글로우: 헤드라인 뒤 입체감 (홈페이지 히어로와 동일) -->
  <div
    class="pointer-events-none absolute -left-24 -top-24 h-[420px] w-[420px] rounded-full opacity-30 blur-[100px]"
    style="background: radial-gradient(circle, #F5C518 0%, transparent 70%);"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 -right-16 h-[380px] w-[380px] rounded-full opacity-20 blur-[110px]"
    style="background: radial-gradient(circle, #F5C518 0%, transparent 70%);"
  >
  </div>

  {
    wordCloud.length > 0 && (
      <div class="pointer-events-none absolute inset-0 z-0 select-none overflow-hidden" aria-hidden="true">
        {wordCloud.map((w) => (
          <span
            class:list={['absolute font-black tracking-tight whitespace-nowrap', w.size]}
            style={`top:${w.top}; left:${w.left}; transform:translate(-50%,-50%) rotate(${w.rotate}deg); opacity:${w.opacity}; color:${w.accent ? '#F5C518' : '#FFFFFF'};`}
          >
            {w.text}
          </span>
        ))}
      </div>
    )
  }

  <div
    class:list={[
      'relative z-10 mx-auto max-w-content items-center gap-10 px-4 py-20 md:px-6 md:py-24',
      hasVisualSlot ? 'grid md:grid-cols-[1.15fr_0.85fr]' : '',
    ]}
  >
    <div>
      <p class="mb-5 text-xs font-bold tracking-[0.2em] text-[#F5C518]">{eyebrow}</p>
      <h1 class="max-w-3xl text-[2.6rem] font-black leading-[1.15] tracking-tight md:text-4xl md:leading-[1.1]">
        {titleMain}{accent && <span class="text-[#F5C518]">{accent}</span>}
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-white/70 md:text-lg">{body}</p>

      {
        (ctaPrimaryLabel || ctaSecondaryLabel) && (
          <div class="mt-9 flex flex-wrap gap-3">
            {ctaPrimaryLabel && (
              <a
                href={ctaPrimaryHref}
                class="rounded-full bg-[#F5C518] px-6 py-3 text-sm font-bold text-thp-navy transition-colors hover:bg-[#D4A70F]"
              >
                {ctaPrimaryLabel}
              </a>
            )}
            {ctaSecondaryLabel && (
              <a
                href={ctaSecondaryHref}
                class="rounded-full border border-white/30 px-6 py-3 text-sm font-bold text-white transition-colors hover:border-white/60"
              >
                {ctaSecondaryLabel}
              </a>
            )}
          </div>
        )
      }

      {
        tags.length > 0 && (
          <div class="mt-12 flex flex-wrap gap-x-6 gap-y-2 text-[16px] font-bold tracking-wider text-white/40">
            {tags.map((tag) => <span>{tag}</span>)}
          </div>
        )
      }
    </div>

    {
      hasVisualSlot && (
        <div class="relative hidden md:block">
          <slot name="visual" />
        </div>
      )
    }
  </div>
</section>
