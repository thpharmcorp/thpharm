---
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const strings = ui[locale];
const year = new Date().getFullYear();

// 2026-08-14: 숨겨진 테마송 이스터에그 — 대표가 제공한 실제 음원 2곡을 배치.
// 의도적으로 화면에 설명 문구를 두지 않는다(진짜 이스터에그). 접근성을 위한 aria-label만 존재.
const hiddenSoundTracks = [
  { id: 'city', src: '/audio/thpharm-theme-city.mp3', label: 'THPHARM Theme — City Mix' },
  { id: 'latin', src: '/audio/thpharm-theme-latin.mp3', label: 'THPHARM Theme — Latin Mix' },
];

// APPROVED_FACTS.md 등록 완료 (2026-08-12) — 회사 제공 스크린샷(기존 홈페이지 Footer) 기준.
const companyInfoLabels: Record<Locale, { biz: string; addr: string; tel: string; fax: string; email: string }> = {
  kr: { biz: '사업자등록번호', addr: '주소', tel: '전화', fax: '팩스', email: '이메일' },
  en: { biz: 'Business Registration No.', addr: 'Address', tel: 'Tel', fax: 'Fax', email: 'Email' },
  'zh-cn': { biz: '营业执照登记号', addr: '地址', tel: '电话', fax: '传真', email: '邮箱' },
  jp: { biz: '事業者登録番号', addr: '住所', tel: '電話', fax: 'FAX', email: 'メール' },
};
const cl = companyInfoLabels[locale];
const companyLegalName = '(주)티에치팜 THPharm';
const bizNo = '789-87-01821';
const address = '(28160) 충청북도 청주시 흥덕구 오송읍 오송생명1로 194-25, 3층 A-06호 (청주 SB플라자)';
const tel = '070-8657-2278';
const fax = '070-4833-2271';
const email = 'admin@thpharm.co.kr';
---

<footer class="border-t border-thp-line bg-thp-mist">
  <div class="mx-auto max-w-content px-4 py-10 md:px-6">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <!-- 2026-08-21: 로고가 법적고지 텍스트와 너무 붙어 있어 튀어 보인다는 피드백 — 헤더에서는
             같은 로고가 안 튀는데, 실제 이유는 로고 자체가 아니라 여백/고립도 차이였다(헤더는 로고
             혼자 떨어져 있고 바로 아래 붙는 콘텐츠가 없음). 로고 색(그라데이션)이나 배경색을 바꾸는
             대신, 헤더처럼 여백을 넓히고 구분선을 넣어 "로고 영역"과 "법적고지 영역"을 분리했다. -->
        <img src="/images/logo.png" alt={companyLegalName} class="mb-5 h-7 w-auto" />
        <p class="border-t border-thp-line pt-4 text-[12px] leading-relaxed text-thp-ink/60">
          {cl.biz} : {bizNo}<br />
          {cl.addr} : {address}<br />
          {cl.tel} : {tel} &nbsp;&nbsp; {cl.fax} : {fax}<br />
          {cl.email} : {email}
        </p>
      </div>
      <nav class="flex flex-col gap-2 text-[14px] text-thp-ink/80" aria-label="Footer">
        <a href={`/${locale}`} class="hover:text-thp-navy2">{strings.footerAbout}</a>
        <a href={`/${locale}/contact`} class="hover:text-thp-navy2">{strings.footerContact}</a>
        <a href={`/${locale}/privacy`} class="hover:text-thp-navy2">{strings.footerPrivacy}</a>
        <a href={`/${locale}/terms`} class="hover:text-thp-navy2">{strings.footerTerms}</a>
        <a href={`/${locale}/sources`} class="hover:text-thp-navy2">{strings.footerSources}</a>
      </nav>
      <div class="flex flex-col items-start gap-3 md:items-end">
        <div class="flex items-center gap-1.5">
          {
            hiddenSoundTracks.map((t) => (
              <button
                type="button"
                class="hidden-sound-trigger flex h-8 w-8 items-center justify-center rounded-full border border-thp-line text-thp-ink/40 transition-colors hover:border-thp-teal hover:text-thp-teal"
                aria-label={t.label}
                data-track={t.id}
              >
                ♪
              </button>
            ))
          }
        </div>
        <p class="text-[12px] text-thp-ink/50">
          {strings.footerCopyright.replace('© THPHARM', `© 2023${year > 2023 ? `–${year}` : ''} THPHARM`)}
        </p>
      </div>
    </div>
  </div>

  {
    hiddenSoundTracks.map((t) => (
      <audio id={`hidden-sound-audio-${t.id}`} src={t.src} preload="none" class="hidden" />
    ))
  }
</footer>

<script>
  // 화면에는 아무 설명도 노출하지 않는 순수 이스터에그 — 음표를 누르면 재생/정지만 토글된다.
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.hidden-sound-trigger'));
  triggers.forEach((trigger) => {
    const trackId = trigger.dataset.track;
    const audio = document.getElementById(`hidden-sound-audio-${trackId}`) as HTMLAudioElement | null;
    if (!audio) return;
    trigger.addEventListener('click', () => {
      const isPlaying = !audio.paused;
      // 한 번에 하나만 재생 — 다른 트랙이 재생 중이면 먼저 멈춘다.
      triggers.forEach((other) => {
        if (other === trigger) return;
        const otherId = other.dataset.track;
        const otherAudio = document.getElementById(`hidden-sound-audio-${otherId}`) as HTMLAudioElement | null;
        otherAudio?.pause();
        other.classList.remove('text-thp-teal', 'border-thp-teal');
      });
      if (isPlaying) {
        audio.pause();
        trigger.classList.remove('text-thp-teal', 'border-thp-teal');
      } else {
        audio.play().catch(() => {});
        trigger.classList.add('text-thp-teal', 'border-thp-teal');
      }
    });
  });
</script>
