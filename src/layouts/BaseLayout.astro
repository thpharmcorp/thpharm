---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, type Locale } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
}

const { locale, title, description = '' } = Astro.props;
const strings = ui[locale];
const htmlLang = locale === 'zh-cn' ? 'zh-CN' : locale === 'jp' ? 'ja' : locale;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | THPHARM</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="noindex, nofollow" />
    <!-- 정식 도메인(thpharm.co.kr) 배포 전까지 검색엔진 색인 제외 유지 -->
  </head>
  <body>
    <a href="#main" class="skip-link">{strings.skipToContent}</a>
    <Header locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
