---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HealthBioDiagram from '../../../components/HealthBioDiagram.astro';
import HealthSectionIcon from '../../../components/HealthSectionIcon.astro';
import { locales, localeToFieldKey, ui, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const topics = await getCollection('health');
  return locales.flatMap((locale) =>
    topics.map((t) => ({ params: { locale, topic: t.data.slug }, props: { entry: t } }))
  );
}

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'health'>>>[number] };
const fk = localeToFieldKey[locale];
const strings = ui[locale];
const d = entry.data;

// 질환별 accent 컬러 — brand teal(비만)을 기준으로 당뇨/고혈압/MASH를 구분되는 색으로 배정.
// 실제 브랜드 컬러 가이드 확정 전까지의 근사값 (APPROVED_FACTS.md 참고).
const accentMap: Record<string, string> = {
  obesity: '#EE7F1A',
  diabetes: '#2563EB',
  hypertension: '#DC2626',
  mash: '#7C3AED',
};
const accent = accentMap[d.slug] ?? '#EE7F1A';

const sections = [
  { key: 'body', label: { kr: '몸에서는 무슨 일이 일어날까?', en: "What's happening in the body?", 'zh-cn': '身体里发生了什么?', jp: '体の中で何が起きているのか?' }, text: d.whatHappensInBody[fk], withDiagram: true },
  { key: 'risk', label: { kr: '위험요인과 검사', en: 'Risk factors & screening', 'zh-cn': '风险因素与检查', jp: '危険因子と検査' }, text: d.riskAndScreening[fk], withDiagram: false },
  { key: 'treatment', label: { kr: '치료의 현재', en: 'Treatment today', 'zh-cn': '当前的治疗', jp: '治療の現在' }, text: d.currentTreatment[fk], withDiagram: false },
  { key: 'trend', label: { kr: '치료의 변화', en: 'How treatment is changing', 'zh-cn': '治疗的变化', jp: '治療の変化' }, text: d.treatmentChanges[fk], withDiagram: false },
] as const;
---

<BaseLayout locale={locale} title={d.title[fk]} description={d.oneMinuteSummary[fk]}>
  <section class="relative overflow-hidden" style={`background: linear-gradient(135deg, ${accent}14 0%, ${accent}05 60%, white 100%);`}>
    <div class="mx-auto max-w-content px-4 py-14 md:px-6 md:py-16">
      <a href={`/${locale}/health`} class="text-xs font-semibold text-thp-ink/40 hover:text-thp-tealDeep">
        ← HEALTH
      </a>
      <p class="mt-4 text-xs font-bold tracking-widest" style={`color:${accent}`}>HEALTH</p>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-thp-navy2 md:text-4xl">{d.title[fk]}</h1>

      <div class="mt-8 flex items-start gap-4 rounded-2xl border bg-white/70 p-6 backdrop-blur-sm" style={`border-color:${accent}33`}>
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full" style={`background:${accent}1a; color:${accent}`}>
          <HealthSectionIcon kind="summary" />
        </div>
        <div>
          <p class="text-xs font-bold tracking-widest text-thp-ink/50">1분 이해</p>
          <p class="mt-2 text-base leading-relaxed text-thp-ink/80">{d.oneMinuteSummary[fk]}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-content px-4 py-12 md:px-6">
      <div class="grid gap-8 md:grid-cols-2">
        {
          sections.map((s) => (
            <div class="rounded-2xl border border-thp-line p-6">
              <div class="flex items-center gap-2.5">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full" style={`background:${accent}14; color:${accent}`}>
                  <HealthSectionIcon kind={s.key} class="h-4 w-4" />
                </div>
                <p class="text-xs font-bold tracking-widest" style={`color:${accent}`}>{s.label[locale]}</p>
              </div>
              {s.withDiagram && (
                <div class="mt-5">
                  <HealthBioDiagram slug={d.slug} accent={accent} />
                </div>
              )}
              <p class="mt-4 text-sm leading-relaxed text-thp-ink/75">{s.text}</p>
            </div>
          ))
        }
      </div>

      {
        d.doctorsNote && (
          <div class="mt-10 rounded-2xl border border-thp-line p-6">
            <div class="flex items-center gap-2.5">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full" style={`background:${accent}14; color:${accent}`}>
                <HealthSectionIcon kind="doctor" class="h-4 w-4" />
              </div>
              <p class="text-xs font-bold tracking-widest" style={`color:${accent}`}>DOCTOR'S NOTE</p>
            </div>
            <p class="mt-4 font-semibold text-thp-navy2">{d.doctorsNote.question[fk]}</p>
            <p class="mt-2 text-sm leading-relaxed text-thp-ink/70">{d.doctorsNote.answer[fk]}</p>
            {(d.doctorsNote.reviewer || d.doctorsNote.lastReviewed) && (
              <p class="mt-3 text-xs text-thp-ink/40">
                Reviewed by {d.doctorsNote.reviewer || strings.companyDataNeeded}
                {d.doctorsNote.lastReviewed && ` · ${strings.lastUpdated}: ${d.doctorsNote.lastReviewed}`}
              </p>
            )}
          </div>
        )
      }

      {
        d.mythVsFact.length > 0 && (
          <div class="mt-10">
            <div class="mb-4 flex items-center gap-2.5">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full" style={`background:${accent}14; color:${accent}`}>
                <HealthSectionIcon kind="myth" class="h-4 w-4" />
              </div>
              <p class="text-xs font-bold tracking-widest" style={`color:${accent}`}>MYTH vs FACT</p>
            </div>
            <div class="space-y-4">
              {d.mythVsFact.map((m) => (
                <div class="rounded-2xl p-6" style={`background:${accent}0d`}>
                  <p class="font-semibold text-thp-navy2">{m.myth[fk]}</p>
                  <p class="mt-2 text-sm leading-relaxed text-thp-ink/70">{m.fact[fk]}</p>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <div class="mt-12 flex flex-wrap gap-x-6 gap-y-2 border-t border-thp-line pt-6 text-sm font-bold text-thp-tealDeep">
        <a href={`/${locale}/health/treatment-trends`} class="hover:underline">
          {locale === 'kr' ? '치료의 변화 더 보기' : 'Treatment Trends'} →
        </a>
        <a href={`/${locale}/health/faq`} class="hover:underline">FAQ →</a>
        <a href={`/${locale}/intelligence`} class="hover:underline">
          {locale === 'kr' ? '관련 논문·산업 분석 보기 (INTELLIGENCE)' : 'Related research & industry analysis (INTELLIGENCE)'} →
        </a>
      </div>

      <p class="mt-6 text-xs text-thp-ink/40">
        본 콘텐츠는 일반 정보 제공 목적이며 진단·처방을 대체하지 않습니다. {strings.lastUpdated}: {d.lastVerified}
      </p>
    </div>
  </section>
</BaseLayout>
