---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, ui, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const strings = ui[locale];

const copy = {
  kr: { title: '치료는 지금도 바뀌고 있습니다.', lead: 'GLP-1 등 최신 치료제와 치료 패러다임의 변화를 정리합니다. 더 깊은 논문·산업 분석은 INTELLIGENCE의 THPHARM VIEW에서 확인할 수 있습니다.' },
  en: { title: 'Treatment is changing right now.', lead: 'A summary of GLP-1 and other recent therapies and shifts in treatment paradigms. For deeper research and industry analysis, see THPHARM View under INTELLIGENCE.' },
  'zh-cn': { title: '治疗方式仍在不断变化。', lead: '梳理GLP-1等最新治疗药物及治疗范式的变化。更深入的论文与产业分析请见INTELLIGENCE中的THPHARM View。' },
  jp: { title: '治療は今も変わり続けています。', lead: 'GLP-1をはじめとする最新治療薬と治療パラダイムの変化を整理します。より深い論文・産業分析はINTELLIGENCEのTHPHARM Viewでご確認いただけます。' },
} as const;
const t = copy[locale];

const categories = [
  {
    key: 'OBESITY',
    slug: 'obesity',
    topics: {
      kr: 'GLP-1 · Incretin · 경구제 · 차세대 비만치료 전략',
      en: 'GLP-1 · Incretin · Oral agents · Next-generation obesity treatment strategies',
      'zh-cn': 'GLP-1 · Incretin · 口服药物 · 下一代肥胖症治疗策略',
      jp: 'GLP-1・インクレチン・経口薬・次世代肥満治療戦略',
    },
  },
  {
    key: 'DIABETES',
    slug: 'diabetes',
    topics: {
      kr: 'GLP-1 · SGLT2 · 복합치료 · 심혈관/신장 보호 전략',
      en: 'GLP-1 · SGLT2 · Combination therapy · Cardiovascular/renal protection strategies',
      'zh-cn': 'GLP-1 · SGLT2 · 联合治疗 · 心血管/肾脏保护策略',
      jp: 'GLP-1・SGLT2・併用療法・心血管/腎保護戦略',
    },
  },
  {
    key: 'HYPERTENSION',
    slug: 'hypertension',
    topics: {
      kr: '복합제 · Single-pill Strategy · 동반질환 관리',
      en: 'Combination products · Single-pill strategy · Comorbidity management',
      'zh-cn': '复方制剂 · Single-pill Strategy · 合并症管理',
      jp: '配合剤・Single-pill Strategy・併存疾患管理',
    },
  },
  {
    key: 'MASH',
    slug: 'mash',
    topics: {
      kr: '새로운 승인 치료제 · GLP-1 연계 · 병용/차세대 전략',
      en: 'Newly approved therapies · GLP-1 linkage · Combination/next-generation strategies',
      'zh-cn': '新获批治疗药物 · GLP-1关联 · 联合/下一代策略',
      jp: '新規承認治療薬・GLP-1連携・併用/次世代戦略',
    },
  },
] as const;
---

<BaseLayout locale={locale} title={t.title} description={t.lead}>
  <section class="bg-white">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <p class="text-xs font-bold tracking-widest text-thp-teal">HEALTH · TREATMENT TRENDS</p>
      <h1 class="mt-3 max-w-2xl text-3xl font-black tracking-tight text-thp-navy2 md:text-4xl">{t.title}</h1>
      <p class="mt-4 max-w-2xl text-thp-ink/70">{t.lead}</p>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {
          categories.map((c) => (
            <a
              href={`/${locale}/health/${c.slug}`}
              class="rounded-2xl border border-thp-line p-6 transition-all hover:-translate-y-1 hover:border-thp-teal hover:shadow-lg hover:shadow-thp-navy/5"
            >
              <p class="text-xs font-bold tracking-widest text-thp-teal">{c.key}</p>
              <p class="mt-3 text-sm leading-relaxed text-thp-ink/75">{c.topics[locale]}</p>
              <p class="mt-4 text-xs font-semibold text-thp-tealDeep">{strings.readMore} →</p>
            </a>
          ))
        }
      </div>

      <a
        href={`/${locale}/intelligence`}
        class="mt-10 inline-flex items-center gap-2 text-sm font-bold text-thp-tealDeep hover:underline"
      >
        THPHARM VIEW ({locale === 'kr' ? '더 깊은 분석' : 'deeper analysis'}) →
      </a>

      <p class="mt-10 text-xs text-thp-ink/40">{strings.lastUpdated}: 2026-08-12</p>
    </div>
  </section>
</BaseLayout>
