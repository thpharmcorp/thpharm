---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroDark from '../../../components/HeroDark.astro';
import HealthSectionIcon from '../../../components/HealthSectionIcon.astro';
import { locales, localeToFieldKey, type Locale } from '../../../i18n/ui';

const accentMap: Record<string, string> = {
  obesity: '#EE7F1A',
  diabetes: '#2563EB',
  hypertension: '#DC2626',
  mash: '#7C3AED',
};

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const fk = localeToFieldKey[locale];

// 2026-08-14 재작성: "대사질환은 하나씩 오지 않습니다"류의 단정형 문장이 가르치는 말투로 읽히고,
// "THPHARM HEALTH가 쉽게 설명합니다"는 표현이 건방지게 느껴진다는 피드백 — HEALTH를 환자·건강정보를
// 찾는 사람들을 위한 커뮤니티에 가깝게 만들고 싶다는 방향에 맞춰, 독자에게 직접 말을 건네는 질문형으로
// 바꾸고 "우리가 설명해준다"가 아니라 "그 마음을 안다"는 톤으로 다시 썼다.
const heroCopy = {
  kr: {
    title: '혼자 찾아보다, 지친 적 있으신가요?',
    body: '비만, 당뇨, 고혈압, MASH — 검색하면 할수록 정보만 넘쳐나고 정작 내 상황엔 답이 잘 안 보이는 병들입니다. 여기 모은 이야기는 그 병들이 서로 어떻게 얽혀 있는지, 요즘 치료법은 어떻게 달라지고 있는지를 환자와 가족의 눈높이에서 정리한 것들입니다.',
    ctaPrimary: '함께 살펴보기',
  },
  en: {
    title: "Ever felt exhausted searching for answers alone?",
    body: "Obesity, diabetes, hypertension, MASH — the more you search, the more information piles up, and the less it feels like it applies to you. What's gathered here looks at how these conditions connect to each other and how treatment is changing, written from where patients and families actually stand.",
    ctaPrimary: "Let's look together",
  },
  'zh-cn': {
    title: '独自查资料查到累了吗?',
    body: '肥胖症、糖尿病、高血压、MASH——越搜索,信息越多,却越难找到真正适用于自己情况的答案。这里汇集的内容,是从患者与家属的视角出发,梳理这些疾病之间的关联,以及治疗方式正在发生的变化。',
    ctaPrimary: '一起来看看',
  },
  jp: {
    title: '一人で調べて、疲れたことはありませんか。',
    body: '肥満、糖尿病、高血圧、MASH——調べれば調べるほど情報だけが増えて、自分の状況に合う答えはなかなか見つからないものです。ここに集めたのは、それらの病気がどうつながっているのか、治療法が今どう変わりつつあるのかを、患者さんとご家族の目線でまとめたものです。',
    ctaPrimary: '一緒に見てみる',
  },
} as const;
const hero = heroCopy[locale];

const topics = await getCollection('health');

const iconKindMap: Record<string, 'obesity' | 'diabetes' | 'hypertension' | 'mash'> = {
  obesity: 'obesity',
  diabetes: 'diabetes',
  hypertension: 'hypertension',
  mash: 'mash',
};

// 2026-08-21: 페이지마다 같은 세포 이미지를 재활용하던 걸 페이지별 워드클라우드로 교체(HeroDark 참고).
// HEALTH는 이 페이지가 실제로 다루는 4대 질환 + 건강정보 커뮤니티 관련 키워드로 구성.
const heroWordCloud = [
  { text: '비만', top: '12%', left: '78%', size: 'text-xl md:text-3xl', rotate: -4, opacity: 0.14, accent: true },
  { text: 'OBESITY', top: '6%', left: '20%', size: 'text-lg md:text-2xl', rotate: 3, opacity: 0.1 },
  { text: '당뇨', top: '30%', left: '90%', size: 'text-xl md:text-2xl', rotate: 4, opacity: 0.12 },
  { text: 'DIABETES', top: '22%', left: '48%', size: 'text-xl md:text-3xl', rotate: -3, opacity: 0.1 },
  { text: '고혈압', top: '52%', left: '84%', size: 'text-2xl md:text-4xl', rotate: -2, opacity: 0.16, accent: true },
  { text: 'HYPERTENSION', top: '46%', left: '18%', size: 'text-base md:text-xl', rotate: 3, opacity: 0.08 },
  { text: 'MASH', top: '68%', left: '62%', size: 'text-xl md:text-2xl', rotate: 2, opacity: 0.12 },
  { text: '대사증후군', top: '82%', left: '30%', size: 'text-base md:text-lg', rotate: -3, opacity: 0.08 },
  { text: 'ADHERENCE', top: '86%', left: '78%', size: 'text-base md:text-lg', rotate: 2, opacity: 0.09 },
  { text: 'FAQ', top: '10%', left: '52%', size: 'text-base md:text-lg', rotate: -5, opacity: 0.07 },
  { text: 'TREATMENT', top: '74%', left: '10%', size: 'text-sm md:text-lg', rotate: 4, opacity: 0.07 },
];
---

<BaseLayout locale={locale} title={hero.title} description={hero.body}>
  <HeroDark
    eyebrow="HEALTH"
    title={hero.title}
    body={hero.body}
    ctaPrimaryLabel={hero.ctaPrimary}
    ctaPrimaryHref={`/${locale}/health#topics`}
    wordCloud={heroWordCloud}
  />

  <section id="topics" class="bg-white scroll-mt-20">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          topics.map((t) => {
            const accent = accentMap[t.data.slug] ?? '#EE7F1A';
            return (
              <a
                href={`/${locale}/health/${t.data.slug}`}
                class="group relative flex flex-col rounded-2xl border border-thp-line p-6 transition-all hover:-translate-y-1 hover:border-transparent hover:shadow-xl"
                style={`--tw-shadow-color:${accent}33`}
              >
                <div class="flex items-start justify-between">
                  <div
                    class="flex h-14 w-14 items-center justify-center rounded-2xl transition-transform group-hover:scale-105"
                    style={`background:${accent}16; color:${accent}`}
                  >
                    <HealthSectionIcon kind={iconKindMap[t.data.slug] ?? 'body'} class="h-7 w-7" />
                  </div>
                  <span class="text-lg text-thp-ink/20 transition-all group-hover:translate-x-1 group-hover:text-thp-tealDeep">→</span>
                </div>
                <p class="mt-5 text-base font-extrabold text-thp-navy2">{t.data.title[fk]}</p>
                <p class="mt-2 line-clamp-3 text-xs leading-relaxed text-thp-ink/55">{t.data.oneMinuteSummary[fk]}</p>
              </a>
            );
          })
        }
      </div>

      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-bold text-thp-tealDeep">
        <a href={`/${locale}/health/treatment-trends`} class="hover:underline">
          {locale === 'kr' ? '치료의 변화' : 'Treatment Trends'} →
        </a>
        <a href={`/${locale}/health/faq`} class="hover:underline">FAQ →</a>
      </div>
    </div>
  </section>
</BaseLayout>
