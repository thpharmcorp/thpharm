---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroDark from '../../../components/HeroDark.astro';
import IrSubnav from '../../../components/IrSubnav.astro';
import { locales, localeToFieldKey, ui, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const fk = localeToFieldKey[locale];
const strings = ui[locale];

const heroCopy = {
  kr: { title: '대사질환 치료제를 실제 개발·임상·사업화로 연결합니다.', body: '투자자·병원·파트너가 필요한 정보를 빠르게 확인할 수 있도록 매출·제품화·임상·파이프라인·마일스톤을 정리합니다.' },
  en: { title: 'Connecting metabolic disease R&D to real clinical development and commercialization.', body: 'Revenue, product development, clinical progress, pipeline, and milestones — organized so investors, hospitals, and partners can quickly find what they need.' },
  'zh-cn': { title: '将代谢性疾病研发切实转化为临床开发与商业化。', body: '我们整理营收、产品化、临床进展、管线与里程碑,让投资者、医院与合作伙伴能够快速获取所需信息。' },
  jp: { title: '代謝性疾患治療薬の研究開発を、実際の臨床開発と事業化へとつなげます。', body: '投資家・病院・パートナーが必要な情報を迅速に確認できるよう、売上・製品化・臨床・パイプライン・マイルストーンを整理しています。' },
} as const;
const hero = heroCopy[locale];

const irDocs = await getCollection('ir');

const sections = [
  { code: 'WEB-701', path: 'investment-highlights', kr: 'INVESTMENT HIGHLIGHTS', body: { kr: '매출·임상·파이프라인 등 핵심 지표 요약', en: 'A summary of key indicators — revenue, clinical progress, and pipeline', 'zh-cn': '营收、临床与管线等核心指标概览', jp: '売上・臨床・パイプラインなど主要指標の要約' } },
  { code: 'WEB-702', path: 'financial-highlights', kr: 'FINANCIAL & OPERATING HIGHLIGHTS', body: { kr: '[회사 자료 확인 필요] 최근 3~5년 공개 가능한 매출·재무 숫자', en: '[COMPANY DATA NEEDED] Recent 3–5 years of disclosable revenue/financial figures', 'zh-cn': '[待公司确认资料] 近3至5年可公开的营收与财务数据', jp: '[会社資料確認待ち] 直近3〜5年間の開示可能な売上・財務数値' } },
  { code: 'WEB-703', path: 'clinical-collaboration', kr: 'CLINICAL RESEARCH COLLABORATION', body: { kr: '병원·PI와의 임상 협력', en: 'Clinical collaboration with hospitals and investigators', 'zh-cn': '与医院、研究者的临床合作', jp: '病院・治験責任医師との臨床協力' } },
  { code: 'WEB-704', path: 'governance', kr: 'GOVERNANCE & TRANSPARENCY', body: { kr: '[회사 자료 확인 필요] Board / Audit / Compliance', en: '[COMPANY DATA NEEDED] Board / Audit / Compliance', 'zh-cn': '[待公司确认资料] 董事会 / 审计 / 合规', jp: '[会社資料確認待ち] 取締役会 / 監査 / コンプライアンス' } },
  { code: 'WEB-705', path: 'partnering', kr: 'BUSINESS PARTNERING', body: { kr: 'BD / Licensing 협력', en: 'BD / licensing collaboration', 'zh-cn': 'BD / 授权合作', jp: 'BD / ライセンス提携' } },
];
---

<BaseLayout locale={locale} title={hero.title} description={hero.body}>
  <IrSubnav locale={locale} current="landing" />
  <HeroDark
    eyebrow="IR & PARTNERING"
    title={hero.title}
    body={hero.body}
    tags={['GOVERNANCE', 'MILESTONES', 'EVIDENCE-BASED IR']}
  />

  <section class="bg-white">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <div class="grid gap-4 md:grid-cols-2">
        {
          sections.map((s) => (
            <a href={`/${locale}/ir/${s.path}`} class="rounded-2xl border border-thp-line p-6 transition-colors hover:border-thp-teal">
              <p class="text-base font-bold text-thp-navy2">{s.kr}</p>
              <p class="mt-2 text-sm text-thp-ink/60">{s.body[locale]}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-thp-line bg-thp-mist">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <a href={`/${locale}/ir/ir-library`} class="mb-6 inline-block text-xs font-bold tracking-widest text-thp-teal hover:underline">
        IR LIBRARY →
      </a>
      <div class="divide-y divide-thp-line rounded-2xl border border-thp-line bg-white">
        {
          irDocs.map((doc) => (
            <div class="flex items-center justify-between p-5">
              <div>
                <p class="text-sm font-bold text-thp-navy2">{doc.data.title[fk]}</p>
                <p class="text-xs text-thp-ink/40">{doc.data.docType} · {doc.data.fiscalYear}</p>
              </div>
              <span class="text-xs font-semibold text-thp-ink/30">{strings.companyDataNeeded}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
