---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import IrSubnav from '../../../components/IrSubnav.astro';
import { locales, ui, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const strings = ui[locale];

const copy = {
  kr: {
    title: '공개 가능한 범위의 재무·운영 성과를 축적합니다.',
    lead: '공개 권장: 최근 3~5년 매출 추이, 주요 제품화/임상 마일스톤, 파이프라인 진척, 특허/공식 성과. 결산자료는 공개 가능한 범위에서 연도별로 축적합니다.',
    approvalNote: '회사 승인 후 공개: R&D 비용, 영업손익, 현금 보유액, cash runway, 파이프라인별 투자금액, 자금조달 계획. "상장사처럼 보이기 위해" 민감 숫자를 무리하게 공개하지 않습니다.',
    archiveNote: '모든 자료에는 Source / 기준일 / 게시일 / Last Verified를 붙이고, 과거 자료에는 "해당 자료는 작성 당시 기준 정보"임을 명시합니다.',
  },
  en: {
    title: 'We accumulate disclosable financial and operating performance.',
    lead: 'Recommended for disclosure: 3–5 years of revenue trends, key commercialization/clinical milestones, pipeline progress, and patent/official achievements. Financial statements are accumulated year by year, within a disclosable scope.',
    approvalNote: 'Disclosed only after company approval: R&D expense, operating profit/loss, cash on hand, cash runway, per-pipeline investment amounts, and fundraising plans. We do not disclose sensitive figures merely to "look like a listed company."',
    archiveNote: 'Every document carries a Source / as-of date / publish date / Last Verified, and older material is explicitly marked as "information as of the time it was prepared."',
  },
  'zh-cn': {
    title: '积累可公开范围内的财务与运营业绩。',
    lead: '建议公开:近3至5年营收趋势、主要产品化/临床里程碑、管线进展及专利/官方成果。结算资料将在可公开范围内按年度积累。',
    approvalNote: '经公司批准后公开:研发费用、营业损益、现金余额、cash runway、各管线投资金额及融资计划。不会为"看起来像上市公司"而勉强公开敏感数字。',
    archiveNote: '所有资料均附有Source / 基准日 / 发布日 / Last Verified,历史资料将明确标注"该资料为编制当时的信息"。',
  },
  jp: {
    title: '公開可能な範囲の財務・運営実績を蓄積します。',
    lead: '公開推奨:直近3〜5年間の売上推移、主要な製品化/臨床マイルストーン、パイプライン進捗、特許/公式実績。決算資料は公開可能な範囲で年度別に蓄積します。',
    approvalNote: '会社承認後に公開:研究開発費、営業損益、現金保有額、cash runway、パイプライン別投資額、資金調達計画。「上場企業らしく見せるため」に機微な数値を無理に公開することはありません。',
    archiveNote: 'すべての資料にSource / 基準日 / 掲載日 / Last Verifiedを付し、過去の資料には「当該資料は作成当時の情報」であることを明記します。',
  },
} as const;
const t = copy[locale];
---

<BaseLayout locale={locale} title={t.title} description={t.lead}>
  <IrSubnav locale={locale} current="financial-highlights" />
  <section class="bg-white">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <p class="text-xs font-bold tracking-widest text-thp-teal">FINANCIAL & OPERATING HIGHLIGHTS</p>
      <h1 class="mt-3 max-w-2xl text-2xl font-black tracking-tight text-thp-navy2 md:text-3xl">{t.title}</h1>
      <p class="mt-4 max-w-2xl text-thp-ink/70">{t.lead}</p>

      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          ['FY2024', 'FY2025', 'FY2026'].map((fy) => (
            <div class="rounded-2xl border border-dashed border-thp-line p-6 text-center">
              <p class="text-xs font-bold tracking-widest text-thp-ink/50">{fy}</p>
              <p class="mt-3 text-xl font-black text-thp-ink/25">—</p>
              <p class="mt-2 text-[16px] font-semibold text-thp-ink/30">{strings.companyDataNeeded}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 rounded-2xl bg-thp-mist p-6">
        <p class="text-sm leading-relaxed text-thp-ink/70">{t.approvalNote}</p>
      </div>
      <p class="mt-6 max-w-2xl text-xs text-thp-ink/40">{t.archiveNote}</p>
    </div>
  </section>
</BaseLayout>
