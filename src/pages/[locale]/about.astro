---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanySubnav from '../../components/CompanySubnav.astro';
import { locales, localeToFieldKey, ui, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const fk = localeToFieldKey[locale];
const strings = ui[locale];

const entry = await getEntry('company-about', 'web-101');
if (!entry) {
  throw new Error('WEB-101 콘텐츠를 찾을 수 없습니다: src/content/company-about/web-101.json 확인');
}
const d = entry.data;
---

<BaseLayout locale={locale} title={d.sectionTitle[fk]} description={d.lead[fk]}>
  <CompanySubnav locale={locale} current="about" />
  <section class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-24">
    <p class="text-xs font-semibold tracking-widest text-thp-teal">ABOUT THPHARM</p>
    <h1 class="mt-3 max-w-3xl text-2xl font-bold leading-snug text-thp-navy2 md:text-4xl">
      {d.sectionTitle[fk]}
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-thp-ink/80">{d.lead[fk]}</p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        d.storySteps.map((step) => (
          <div class="rounded-lg border border-thp-line bg-white p-6">
            <p class="text-xs font-bold tracking-wide text-thp-teal">{step.label[fk]}</p>
            <p class="mt-2 text-sm leading-relaxed text-thp-ink/80">{step.body[fk]}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-14 rounded-lg bg-thp-mist p-6">
      <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-thp-ink/60">
        THPHARM Development Engine
      </p>
      <div class="flex flex-wrap items-center gap-2 text-sm font-medium text-thp-navy2">
        {
          d.developmentEngine.map((step, i) => (
            <>
              <span>{step[fk]}</span>
              {i < d.developmentEngine.length - 1 && <span class="text-thp-ink/30">→</span>}
            </>
          ))
        }
      </div>
    </div>

    <p class="mt-6 text-[12px] text-thp-ink/35">{strings.lastUpdated}: {d.lastUpdated}</p>
  </section>
</BaseLayout>
