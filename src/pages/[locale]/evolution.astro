---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanySubnav from '../../components/CompanySubnav.astro';
import { locales, ui, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const strings = ui[locale];

const copy = {
  kr: { title: '역량이 확장되어 온 흐름', lead: '일반적인 회사 연혁 대신, 티에치팜의 개발 역량이 어떻게 확장되어 왔는지를 보여주는 타임라인입니다. 정확한 설립일·투자·특허·임상 시작일·파트너십은 회사 공식자료 확인 후 채웁니다.' },
  en: { title: 'How our capabilities have evolved', lead: "Rather than a conventional company history, this is a timeline of how THPHARM's development capabilities have expanded. Exact founding date, investment, patents, clinical trial start dates, and partnerships will be filled in once confirmed against official company records." },
  'zh-cn': { title: '能力扩展的历程', lead: '这并非传统意义上的公司沿革,而是展示THPHARM开发能力如何逐步扩展的时间线。准确的成立日期、投资、专利、临床试验开始日期及合作关系,将在核实公司官方资料后填写。' },
  jp: { title: '能力が拡張してきた歩み', lead: '一般的な会社沿革ではなく、THPHARMの開発能力がどのように拡張してきたかを示すタイムラインです。正確な設立日・投資・特許・臨床開始日・パートナーシップは、会社公式資料の確認後に記入します。' },
} as const;
const t = copy[locale];

const stages = [
  { en: 'Drug Re-engineering', kr: '개량신약 역량 확보' },
  { en: 'Clinical Validation', kr: '임상 검증 경험 축적' },
  { en: 'Metabolic Expansion', kr: '대사질환 영역으로 확장' },
  { en: 'Bio-AI Integration', kr: 'Bio-AI 결합' },
  { en: 'Advanced Research Technology', kr: '바이오프린팅 등 고도 연구기술' },
];
---

<BaseLayout locale={locale} title={t.title} description={t.lead}>
  <CompanySubnav locale={locale} current="evolution" />
  <section class="bg-white">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <p class="text-xs font-bold tracking-widest text-thp-teal">OUR EVOLUTION</p>
      <h1 class="mt-3 max-w-2xl text-3xl font-black tracking-tight text-thp-navy2 md:text-4xl">{t.title}</h1>
      <p class="mt-4 max-w-2xl text-thp-ink/70">{t.lead}</p>

      <div class="mt-12 space-y-4">
        {
          stages.map((s, i) => (
            <div class="flex items-start gap-4">
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-thp-teal/10 text-xs font-bold text-thp-tealDeep">
                {i + 1}
              </div>
              <div>
                <p class="text-sm font-bold text-thp-navy2">{s.en}</p>
                <p class="text-sm text-thp-ink/60">{s.kr}</p>
              </div>
            </div>
          ))
        }
        <div class="flex items-start gap-4">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-thp-navy2 text-xs font-bold text-white">→</div>
          <div>
            <p class="text-sm font-bold text-thp-teal">NEXT: Integrated Metabolic Drug Development Company</p>
          </div>
        </div>
      </div>

      <p class="mt-10 text-xs font-semibold text-thp-ink/30">{strings.companyDataNeeded} — 설립일 / 투자 / 특허 / 임상 시작일 / 파트너십 상세 연도</p>
    </div>
  </section>
</BaseLayout>
