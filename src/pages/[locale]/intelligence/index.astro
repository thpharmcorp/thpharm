---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroDark from '../../../components/HeroDark.astro';
import { locales, localeToFieldKey, ui, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const fk = localeToFieldKey[locale];
const strings = ui[locale];

const heroCopy = {
  kr: { title: '정보가 아니라, 의미를 봅니다.', body: '매일 쏟아지는 뉴스·논문·임상결과·승인·투자 가운데 대사질환과 신약개발에 중요한 신호를 선별하고 연결합니다. 현재는 로그인 없이 누구나 볼 수 있습니다.' },
  en: { title: "We don't just track information — we read meaning.", body: 'From the flood of daily news, papers, clinical results, approvals, and investment, we select and connect the signals that matter for metabolic disease and drug development. Currently open to everyone — no login required.' },
  'zh-cn': { title: '我们关注的不是信息本身,而是其意义。', body: '从每日涌现的新闻、论文、临床结果、审批与投融资中,筛选并连接对代谢性疾病与新药开发真正重要的信号。目前无需登录,任何人都可以查看。' },
  jp: { title: '情報ではなく、意味を見ます。', body: '日々あふれるニュース・論文・臨床結果・承認・投資の中から、代謝性疾患と新薬開発にとって重要なシグナルを選別し、つなげます。現在はログイン不要で、どなたでもご覧いただけます。' },
} as const;
const hero = heroCopy[locale];

// 2026-08-21: 페이지마다 같은 세포 이미지를 재활용하던 걸 페이지별 워드클라우드로 교체(HeroDark 참고).
// INTELLIGENCE는 이 페이지 자체가 쓰는 분류 체계(SCAN/CONNECT/ORGANIZE/PERSPECTIVE/EXPLORE,
// 콘텐츠 종류 라벨)를 그대로 가져와 구성 — 새 단어를 지어내지 않음.
// 2026-08-25: 히어로 바로 아래에 있던 SCAN/CONNECT/ORGANIZE/PERSPECTIVE/EXPLORE 5단계 설명
// 섹션(scopeStages/scopeGroupLabel)은 히어로 문구("정보가 아니라, 의미를 봅니다")와 같은 말을
// 다시 풀어 설명하는 느낌이 강해 "중언부언" 피드백으로 제거했다. 이 다섯 단어는 워드클라우드
// 텍스처로만 남아있고, 별도 설명 섹션은 없다.
const heroWordCloud = [
  { text: 'SCAN', top: '8%', left: '22%', size: 'text-lg md:text-2xl', rotate: -3, opacity: 0.1 },
  { text: 'CONNECT', top: '4%', left: '72%', size: 'text-xl md:text-3xl', rotate: 3, opacity: 0.14, accent: true },
  { text: 'ORGANIZE', top: '26%', left: '46%', size: 'text-lg md:text-2xl', rotate: -2, opacity: 0.1 },
  { text: 'PERSPECTIVE', top: '40%', left: '86%', size: 'text-lg md:text-2xl', rotate: 4, opacity: 0.1 },
  { text: 'EXPLORE', top: '56%', left: '16%', size: 'text-xl md:text-3xl', rotate: -3, opacity: 0.14, accent: true },
  { text: '신문기사', top: '70%', left: '68%', size: 'text-base md:text-lg', rotate: 2, opacity: 0.08 },
  { text: '연구 신호', top: '84%', left: '32%', size: 'text-base md:text-lg', rotate: -4, opacity: 0.08 },
  { text: 'THPHARM VIEW', top: '18%', left: '6%', size: 'text-sm md:text-lg', rotate: 3, opacity: 0.07 },
  { text: 'BIO-AI ATLAS', top: '88%', left: '80%', size: 'text-sm md:text-lg', rotate: -2, opacity: 0.07 },
];

// 2026-08-13: 구 NEWSROOM(WEB-600)을 INTELLIGENCE로 통합 — kind: 'news' 포함.
const feedItems = (
  await getCollection(
    'intelligence',
    (e) =>
      e.data.kind === 'research_radar' ||
      e.data.kind === 'thpharm_view' ||
      e.data.kind === 'scope_spotlight' ||
      e.data.kind === 'news' ||
      e.data.kind === 'paper'
  )
).sort((a, b) => (a.data.publishedAt < b.data.publishedAt ? 1 : -1));

const atlasCards = await getCollection('intelligence', (e) => e.data.kind === 'bio_ai_atlas_card');

const atlasNoteCopy = {
  kr: 'AI 모델을 역할별로 비교해서 쉽게 이해합니다. THPHARM이 이 모델들을 직접 개발한 것은 아니며, 출처·라이선스를 함께 표시합니다.',
  en: 'Compare AI models by role, in plain terms. THPHARM did not develop these models itself — sources and licenses are shown alongside each.',
  'zh-cn': '按角色比较AI模型,以易懂的方式呈现。THPHARM并未自行开发这些模型,来源与许可信息将一并标注。',
  jp: 'AIモデルを役割別に比較し、わかりやすく理解できます。THPHARMがこれらのモデルを自社開発したわけではなく、出典とライセンスをあわせて表示します。',
} as const;

// 분류체계(카드 필터) — kind별 라벨. "신문기사/연구신호/THPHARM 관점/스포트라이트" 4종.
const kindLabels: Record<Locale, Record<string, string>> = {
  kr: { news: '신문기사', paper: '논문', research_radar: '연구 신호', thpharm_view: 'THPHARM 관점', scope_spotlight: '스포트라이트' },
  en: { news: 'News', paper: 'Paper', research_radar: 'Research Signal', thpharm_view: 'THPHARM View', scope_spotlight: 'Spotlight' },
  'zh-cn': { news: '新闻', paper: '论文', research_radar: '研究信号', thpharm_view: 'THPHARM观点', scope_spotlight: '专题聚焦' },
  jp: { news: 'ニュース', paper: '論文', research_radar: '研究シグナル', thpharm_view: 'THPHARM視点', scope_spotlight: 'スポットライト' },
};
const kl = kindLabels[locale];
const allLabel = { kr: '전체', en: 'ALL', 'zh-cn': '全部', jp: 'すべて' }[locale];
// 2026-08-24: "THPHARM 관점" 필터 탭이 어색하다는 피드백으로 필터 메뉴에서만 제외한다.
// thpharm_view 콘텐츠 자체는 계속 feedItems에 남아있어 "전체" 탭과 카드 목록에는 그대로 노출되고,
// 개별 카드 배지(kl[item.data.kind])도 그대로 "THPHARM 관점"이라고 표시된다 — 없어지는 건 이 필터
// 버튼 하나뿐이다.
const kindsPresent = Array.from(new Set(feedItems.map((it) => it.data.kind))).filter((k) => k !== 'thpharm_view');
---

<BaseLayout locale={locale} title={hero.title} description={hero.body}>
  <HeroDark eyebrow="INTELLIGENCE" title={hero.title} body={hero.body} wordCloud={heroWordCloud} />

  <section class="border-t border-thp-line bg-thp-mist">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <p class="mb-6 text-xs font-bold tracking-widest text-thp-teal">FEED</p>

      <div class="mb-8 flex flex-wrap gap-2" id="kind-filter">
        <button type="button" data-kind="all" class="filter-btn rounded-full bg-thp-navy2 px-4 py-1.5 text-xs font-bold text-white">
          {allLabel}
        </button>
        {
          kindsPresent.map((k) => (
            <button type="button" data-kind={k} class="filter-btn rounded-full border border-thp-line bg-white px-4 py-1.5 text-xs font-bold text-thp-ink/60">
              {kl[k]}
            </button>
          ))
        }
      </div>

      <div class="space-y-4" id="feed-list">
        {
          feedItems.map((item) => (
            <a
              href={`/${locale}/intelligence/${item.id}`}
              data-kind={item.data.kind}
              class="feed-card block rounded-2xl border border-thp-line bg-white p-6 transition-colors hover:border-thp-teal"
            >
              <div class="flex flex-wrap items-center gap-2 text-[16px] font-bold text-thp-ink/40">
                <span class="rounded-full bg-thp-teal/10 px-2 py-0.5 text-thp-tealDeep">{kl[item.data.kind]}</span>
                <span class="ml-auto">{item.data.publishedAt}</span>
              </div>
              <p class="mt-3 text-lg font-extrabold text-thp-navy2">{item.data.title[fk]}</p>
              <p class="mt-1 text-sm text-thp-ink/60">{item.data.dek[fk]}</p>
              {
                item.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-x-2 gap-y-1">
                    {item.data.tags.map((t) =>
                      t.url ? (
                        <a
                          href={t.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-[16px] font-semibold text-thp-tealDeep underline decoration-thp-teal/40 underline-offset-2 hover:text-thp-teal"
                          onclick="event.stopPropagation()"
                        >
                          #{t.label} ↗
                        </a>
                      ) : (
                        <span class="text-[16px] font-semibold text-thp-ink/40">#{t.label}</span>
                      )
                    )}
                  </div>
                )
              }
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-thp-line bg-thp-navy text-white">
    <div class="mx-auto max-w-content px-4 py-14 md:px-6 md:py-16">
      <p class="text-xs font-bold tracking-widest text-thp-teal">BIO-AI PLAYGROUND</p>
      <p class="mt-3 max-w-xl text-lg font-black leading-snug">
        {locale === 'kr'
          ? 'GLP-1 receptor를 직접 돌려보고, AI가 대사질환을 어떻게 보는지 체험하세요.'
          : locale === 'en'
            ? 'Rotate GLP-1 receptor yourself and see how AI looks at metabolic disease.'
            : locale === 'zh-cn'
              ? '亲自旋转GLP-1受体,体验AI如何看待代谢性疾病。'
              : 'GLP-1受容体を自分の手で回転させ、AIが代謝性疾患をどう見ているか体験してください。'}
      </p>
      <a
        href={`/${locale}/intelligence/playground`}
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-thp-teal px-6 py-3 text-sm font-bold text-white hover:bg-thp-tealDeep"
      >
        {locale === 'kr' ? 'Bio-AI Playground 열기' : 'Open Bio-AI Playground'} →
      </a>
    </div>
  </section>

  <section id="atlas" class="scroll-mt-20 bg-white">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <p class="mb-2 text-xs font-bold tracking-widest text-thp-teal">BIO-AI ATLAS</p>
      <p class="mb-8 max-w-lg text-sm text-thp-ink/60">{atlasNoteCopy[locale]}</p>
      <div class="grid gap-4 md:grid-cols-2">
        {
          atlasCards.map((card) => (
            <div class="rounded-2xl border border-thp-line p-6">
              <p class="text-[16px] font-bold tracking-wider text-thp-teal">{card.data.dek[fk]}</p>
              <p class="mt-2 text-base font-bold text-thp-navy2">{card.data.title[fk]}</p>
              <p class="mt-3 text-sm leading-relaxed text-thp-ink/70">{card.data.body[fk]}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {card.data.tags.map((t) =>
                  t.url ? (
                    <a
                      href={t.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="rounded-full border border-thp-teal/40 px-2.5 py-0.5 text-[15px] font-semibold text-thp-tealDeep hover:bg-thp-teal/10"
                    >
                      #{t.label} ↗
                    </a>
                  ) : (
                    <span class="rounded-full border border-thp-line px-2.5 py-0.5 text-[15px] font-semibold text-thp-ink/50">#{t.label}</span>
                  )
                )}
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-xs text-thp-ink/40">
        {strings.source}: AlphaFold DB (CC BY 4.0) / RoseTTAFold / Chai-1 / Boltz / RFdiffusion / ProteinMPNN — 각 공식 저장소 및 라이선스 기준.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#kind-filter .filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.feed-card');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.remove('bg-thp-navy2', 'text-white');
        b.classList.add('border', 'border-thp-line', 'bg-white', 'text-thp-ink/60');
      });
      btn.classList.add('bg-thp-navy2', 'text-white');
      btn.classList.remove('border', 'border-thp-line', 'bg-white', 'text-thp-ink/60');

      const kind = btn.dataset.kind;
      cards.forEach((card) => {
        (card as HTMLElement).style.display = kind === 'all' || card.dataset.kind === kind ? '' : 'none';
      });
    });
  });
</script>
