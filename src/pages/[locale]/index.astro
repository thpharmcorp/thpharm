---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HealthSectionIcon from '../../components/HealthSectionIcon.astro';
import { locales, localeToFieldKey, ui, driveFramework, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const fk = localeToFieldKey[locale];
const strings = ui[locale];

const entry = await getEntry('company-landing', 'web-100');
if (!entry) {
  throw new Error('WEB-100 콘텐츠를 찾을 수 없습니다: src/content/company-landing/web-100.json 확인');
}
const d = entry.data;

const accentMap: Record<string, string> = {
  obesity: '#EE7F1A',
  diabetes: '#2563EB',
  hypertension: '#DC2626',
  mash: '#7C3AED',
};

const keyFocusCopy: Record<Locale, { eyebrow: string; title: string }> = {
  kr: { eyebrow: 'KEY FOCUS', title: '티에치팜이 집중하는 4대 대사질환' },
  en: { eyebrow: 'KEY FOCUS', title: 'Four metabolic diseases we focus on' },
  'zh-cn': { eyebrow: 'KEY FOCUS', title: 'THPHARM聚焦的四大代谢性疾病' },
  jp: { eyebrow: 'KEY FOCUS', title: 'THPHARMが注力する4大代謝性疾患' },
};
const keyFocus = keyFocusCopy[locale];
// 2026-08-25: HEALTH 메뉴 확장으로 health 컬렉션에 Tier 2(피부/모발 등 종합 건강정보) 항목이
// 추가됨 — 이 섹션은 제목 그대로 "우리가 집중하는 4대 대사질환"이므로 Tier 1('focus')만 남긴다.
// 필터링 없이 그대로 두면 새 Tier 2 항목까지 KEY FOCUS에 섞여 나와 계획안 §1의 취지(THPHARM
// 포커스와 종합 건강정보를 시각적으로 분리)에 어긋난다.
const healthTopics = (await getCollection('health')).filter((t) => t.data.tier === 'focus');

const iconKindMap: Record<string, 'obesity' | 'diabetes' | 'hypertension' | 'mash'> = {
  obesity: 'obesity',
  diabetes: 'diabetes',
  hypertension: 'hypertension',
  mash: 'mash',
};

// 2026-08-14 재작성: 기존 문장이 히어로(heroBody: "Bio-AI로 다시 읽고, 바이오프린팅으로 검증하며,
// 임상에서 증명합니다")와 동사만 바꿔 사실상 같은 말을 반복한다는 피드백 — 히어로가 "왜"를 말한다면
// 이 섹션은 "어떻게"를 다섯 글자(DRIVE)로 구체적으로 짚어, 처음으로 홈페이지에서 DRIVE라는 이름과
// 그 안의 다섯 단계를 직접 소개하도록 바꿨다. SCIENCE 페이지의 DRIVE 설명과 이어지는 진입점 역할.
const devEngineCopy: Record<Locale, string> = {
  kr: '우리는 이 다섯 단계를 DRIVE라고 부릅니다. 약을 다시 설계하고(Design), Bio-AI로 새 가능성을 찾고(Reveal), 대사질환의 언어로 해석하고(Interpret), 사람에 가장 가까운 조건에서 검증하고(Validate), 임상에서 증명해 환자에게 전합니다(Execute).',
  en: 'We call these five steps DRIVE: re-engineer a medicine (Design), find new possibilities with Bio-AI (Reveal), interpret them through the language of metabolic disease (Interpret), validate them under conditions closest to the human body (Validate), and prove them in the clinic before reaching patients (Execute).',
  'zh-cn': '我们把这五个步骤称为DRIVE:重新设计药物(Design)、用Bio-AI发现新的可能性(Reveal)、以代谢性疾病的语言加以解读(Interpret)、在最贴近人体的条件下验证(Validate)、并在临床中加以证明后交付患者(Execute)。',
  jp: '私たちはこの5つの段階をDRIVEと呼んでいます。薬を再設計し(Design)、Bio-AIで新たな可能性を見つけ(Reveal)、代謝性疾患の言葉で解釈し(Interpret)、人に最も近い条件で検証し(Validate)、臨床で証明して患者さんに届けます(Execute)。',
};

// 히어로 아래 "실제로 뭘 하고 있는 회사인지" 보여주는 최신 신호 3건 — INTELLIGENCE에서 직접 가져온다.
// 정적 "증명 문구" 대신 실제로 갱신되는 콘텐츠를 보여주는 편이 더 정직하다는 판단 (2026-08-13).
const latestSignals = (
  await getCollection(
    'intelligence',
    (e) => e.data.kind === 'news' || e.data.kind === 'research_radar' || e.data.kind === 'paper' || e.data.kind === 'thpharm_view'
  )
)
  .sort((a, b) => (a.data.publishedAt < b.data.publishedAt ? 1 : -1))
  .slice(0, 3);

const latestSignalsLabel = { kr: '최신 동향', en: 'Latest Signals', 'zh-cn': '最新动态', jp: '最新アップデート' }[locale];
const latestSignalsMore = { kr: 'INTELLIGENCE 전체 보기', en: 'View all in Intelligence', 'zh-cn': '查看全部 Intelligence', jp: 'INTELLIGENCEをすべて見る' }[locale];

// 2026-08-24: "이번 주 테마"(BEYOND WEIGHT LOSS) — 기획자가 지정한 주간 편집 큐레이션.
// CLAUDE.md 원칙대로 자동 배치가 아니라 3개 항목과 티어(Featured/Science Pick/Technology
// Watch)를 직접 지정한다. weeklyThemeActive를 false로 바꾸면 아래의 자동 latestSignals
// 그리드로 되돌아간다 — 다음 주 새 테마가 없으면 이 스위치만 끄면 됨.
const weeklyThemeActive = true;
const weeklyThemeCopy: Record<Locale, { eyebrow: string; label: string; subLabel: string; lead: string }> = {
  kr: {
    eyebrow: 'THIS WEEK — INTELLIGENCE',
    label: 'BEYOND WEIGHT LOSS',
    subLabel: '감량 이후의 신약개발',
    lead: '체중감량은 치료의 끝이 아닐 수 있습니다.\n유지, 조직 회복, 그리고 더 정밀한 검증이 다음 경쟁이 되고 있습니다.',
  },
  en: {
    eyebrow: 'THIS WEEK — INTELLIGENCE',
    label: 'BEYOND WEIGHT LOSS',
    subLabel: 'Drug development after the weight is gone',
    lead: 'Losing weight may not be where treatment ends.\nMaintenance, tissue recovery, and more precise verification are becoming the next competition.',
  },
  'zh-cn': {
    eyebrow: 'THIS WEEK — INTELLIGENCE',
    label: 'BEYOND WEIGHT LOSS',
    subLabel: '减重之后的新药开发',
    lead: '体重减轻或许并非治疗的终点。\n体重维持、组织修复与更精准的验证,正在成为下一轮竞争。',
  },
  jp: {
    eyebrow: 'THIS WEEK — INTELLIGENCE',
    label: 'BEYOND WEIGHT LOSS',
    subLabel: '減量後の創薬',
    lead: '体重減少は治療の終わりではないかもしれません。\n維持、組織回復、そしてより精密な検証が次の競争になりつつあります。',
  },
};

const weeklyThemeItemDefs: Array<{ tier: Record<Locale, string>; id: string }> = [
  {
    tier: { kr: 'FEATURED', en: 'FEATURED', 'zh-cn': 'FEATURED', jp: 'FEATURED' },
    id: 'research-env308-weight-maintenance',
  },
  {
    tier: { kr: 'SCIENCE PICK', en: 'SCIENCE PICK', 'zh-cn': 'SCIENCE PICK', jp: 'SCIENCE PICK' },
    id: 'paper-obesity-regression-proteomic-atlas',
  },
  {
    tier: { kr: 'TECHNOLOGY WATCH', en: 'TECHNOLOGY WATCH', 'zh-cn': 'TECHNOLOGY WATCH', jp: 'TECHNOLOGY WATCH' },
    id: 'research-biolamina-axion-organoid-mea',
  },
];
const weeklyThemeItemsRaw = weeklyThemeActive
  ? await Promise.all(
      weeklyThemeItemDefs.map(async (def) => {
        const e = await getEntry('intelligence', def.id);
        return e ? { ...def, entry: e } : null;
      })
    )
  : [];
const weeklyThemeItems = weeklyThemeItemsRaw.filter((x): x is NonNullable<typeof x> => x !== null);

// FEATURED 카드에 넣을 "GLP-1 시작 → 중단 → ?" 플로우 라벨 — 원문 기획안의 인포그래픽 제안을
// 정적 HTML/CSS 흐름도로 구현(사진/애니메이션 없이 타이포그래피 중심, 사이트 톤과 일치).
const glp1FlowLabels = {
  start: { kr: 'GLP-1 시작', en: 'GLP-1 START', 'zh-cn': 'GLP-1 开始', jp: 'GLP-1 開始' }[locale],
  loss: { kr: '체중 감량', en: 'WEIGHT LOSS', 'zh-cn': '体重减轻', jp: '体重減少' }[locale],
  stop: { kr: 'GLP-1 중단', en: 'GLP-1 STOP', 'zh-cn': 'GLP-1 停药', jp: 'GLP-1 中止' }[locale],
  regain: { kr: '체중 재증가', en: 'REGAIN', 'zh-cn': '体重反弹', jp: 'リバウンド' }[locale],
  maintenance: {
    kr: '체중 유지 — ENV-308이 노리는 지점',
    en: 'MAINTENANCE — where ENV-308 is aiming',
    'zh-cn': '体重维持——ENV-308的目标',
    jp: '体重維持 — ENV-308が狙う領域',
  }[locale],
};

// SCIENCE PICK 카드에 넣을 장기별 회복 상태 — Nature Metabolism 논문에서 실제로 확인된
// 조직만 표시(백색지방=염증 지속, 뇌·신장·뼈·흉선·비장=회복 지연). 확인 안 된 장기는 넣지 않음.
const organRecoveryLabel = {
  kr: 'WEIGHT RECOVERY ≠ SYSTEM RECOVERY',
  en: 'WEIGHT RECOVERY ≠ SYSTEM RECOVERY',
  'zh-cn': '体重恢复 ≠ 全身恢复',
  jp: '体重回復 ≠ 全身回復',
}[locale];
const delayedLabel = { kr: '회복 지연', en: 'Delayed', 'zh-cn': '延迟恢复', jp: '回復遅延' }[locale];
const persistentLabel = { kr: '염증 지속', en: 'Persistent', 'zh-cn': '持续存在', jp: '持続' }[locale];
const organItems: Array<{ organ: string; status: string; top: string; left: string; state: 'delayed' | 'persistent' }> = [
  { organ: { kr: '뇌', en: 'Brain', 'zh-cn': '脑', jp: '脳' }[locale], status: delayedLabel, top: '8%', left: '50%', state: 'delayed' },
  { organ: { kr: '흉선', en: 'Thymus', 'zh-cn': '胸腺', jp: '胸腺' }[locale], status: delayedLabel, top: '32%', left: '38%', state: 'delayed' },
  { organ: { kr: '비장', en: 'Spleen', 'zh-cn': '脾脏', jp: '脾臓' }[locale], status: delayedLabel, top: '44%', left: '64%', state: 'delayed' },
  { organ: { kr: '백색지방', en: 'White Adipose', 'zh-cn': '白色脂肪', jp: '白色脂肪' }[locale], status: persistentLabel, top: '58%', left: '50%', state: 'persistent' },
  { organ: { kr: '신장', en: 'Kidney', 'zh-cn': '肾', jp: '腎臓' }[locale], status: delayedLabel, top: '60%', left: '30%', state: 'delayed' },
  { organ: { kr: '뼈', en: 'Bone', 'zh-cn': '骨', jp: '骨' }[locale], status: delayedLabel, top: '86%', left: '50%', state: 'delayed' },
];
const organRestNote = {
  kr: '위 조직 외 대부분은 체중감량 후 정상(lean) 수준에 가깝게 회복',
  en: 'Most tissues besides these returned to near-normal (lean) levels after weight loss',
  'zh-cn': '除上述组织外,大多数组织在体重减轻后恢复至接近正常(瘦体)水平',
  jp: '上記以外の大半の組織は、体重減少後にほぼ正常(lean)レベルへ回復',
}[locale];

// TECHNOLOGY WATCH 카드에 넣을 오가노이드 5단계 — 애니메이션은 다음 단계 과제로 남기고,
// 이번엔 정적 플로우로 구현(HeroDark/DRIVE와 같은 "타이포그래피 플로우" 톤 유지).
const organoidSteps = [
  { kr: '3D 오가노이드', en: '3D ORGANOID', 'zh-cn': '3D类器官', jp: '3Dオルガノイド' },
  { kr: '기능 센서(MEA)', en: 'FUNCTION SENSOR', 'zh-cn': '功能传感器', jp: '機能センサー' },
  { kr: '데이터', en: 'DATA', 'zh-cn': '数据', jp: 'データ' },
  { kr: 'AI 분석', en: 'AI ANALYSIS', 'zh-cn': 'AI分析', jp: 'AI解析' },
  { kr: '신약 의사결정', en: 'DRUG DECISION', 'zh-cn': '新药决策', jp: '創薬判断' },
].map((s) => s[locale]);

// 2026-08-21: 히어로 배경에 "워드클라우드" 텍스처를 새로 추가 — 사용자가 참고로 보낸 이미지(당뇨 관련
// 붉은 스톡 워드클라우드)는 그대로 쓰지 않고(라이선스 불명 스톡 이미지), 같은 "느낌"만 티에치팜이
// 실제로 다루는 4대 대사질환 + 실제 접근법 키워드로 새로 만들어 브랜드 톤(다크브라운 + 오렌지/옐로우)에
// 맞게 재해석했다. 헤드라인 가독성을 해치지 않도록 대부분 낮은 불투명도(4~14%)로 배경에 깔고,
// 일부만 오렌지/옐로우 악센트로 살짝 강조. 실제 존재하는 의학/과학 용어만 사용(회사 고유 수치·실적
// 등 확인되지 않은 사실은 포함하지 않음).
const heroWordCloud: Array<{ text: string; top: string; left: string; size: string; rotate: number; opacity: number; accent?: boolean }> = [
  { text: 'OBESITY', top: '10%', left: '68%', size: 'text-2xl md:text-3xl', rotate: -6, opacity: 0.12 },
  { text: '비만', top: '20%', left: '90%', size: 'text-xl md:text-2xl', rotate: 4, opacity: 0.14, accent: true },
  { text: 'DIABETES', top: '6%', left: '38%', size: 'text-xl md:text-3xl', rotate: 3, opacity: 0.1 },
  { text: '당뇨', top: '32%', left: '78%', size: 'text-2xl md:text-4xl', rotate: -3, opacity: 0.16, accent: true },
  { text: 'HYPERTENSION', top: '46%', left: '62%', size: 'text-lg md:text-2xl', rotate: 5, opacity: 0.1 },
  { text: '고혈압', top: '58%', left: '85%', size: 'text-xl md:text-2xl', rotate: -4, opacity: 0.12 },
  { text: 'MASH', top: '68%', left: '68%', size: 'text-2xl md:text-4xl', rotate: 2, opacity: 0.14, accent: true },
  { text: '대사질환', top: '80%', left: '40%', size: 'text-lg md:text-2xl', rotate: -2, opacity: 0.1 },
  { text: 'GLP-1', top: '14%', left: '14%', size: 'text-lg md:text-xl', rotate: -5, opacity: 0.08 },
  { text: 'SGLT2', top: '86%', left: '16%', size: 'text-lg md:text-xl', rotate: 4, opacity: 0.08 },
  { text: '인슐린저항성', top: '78%', left: '82%', size: 'text-base md:text-lg', rotate: 3, opacity: 0.09 },
  { text: 'METABOLIC SYNDROME', top: '4%', left: '8%', size: 'text-sm md:text-lg', rotate: -2, opacity: 0.07 },
  { text: 'FDC · 복합제', top: '92%', left: '58%', size: 'text-base md:text-lg', rotate: -3, opacity: 0.09 },
  { text: 'BIO-AI', top: '48%', left: '6%', size: 'text-lg md:text-2xl', rotate: 2, opacity: 0.1 },
  { text: 'CARDIORENAL', top: '38%', left: '20%', size: 'text-sm md:text-base', rotate: -4, opacity: 0.07 },
];
---

<BaseLayout locale={locale} title={d.heroTitle[fk]} description={d.heroBody[fk]}>
  <!-- 2026-08-14: 홈페이지 히어로만 "볼드 타이포그래피" 스타일로 재설계 (사용자 요청 참고 템플릿의
       느낌만 차용 — 실제 화면 구성은 그대로 티에치팜 콘텐츠에 맞춤). 장식 이미지를 없애고 헤드라인
       타이포그래피 자체를 비주얼로 삼는다. 다른 페이지의 공용 HeroDark는 건드리지 않는다(홈페이지만
       우선 적용하기로 확정). -->
  <section class="relative overflow-hidden bg-thp-navy text-white">
    <div
      class="pointer-events-none absolute -left-32 -top-32 h-[520px] w-[520px] rounded-full opacity-25 blur-[120px]"
      style="background: radial-gradient(circle, #F5C518 0%, transparent 70%);"
    />

    <!-- 워드클라우드 텍스처: 헤드라인 뒤에 낮은 불투명도로 깔아 "정보가 흩어져 있던 것을 티에치팜이
         하나로 모은다"는 느낌을 배경으로 표현. z-0로 콘텐츠(z-10)보다 아래. -->
    <div class="pointer-events-none absolute inset-0 z-0 select-none overflow-hidden" aria-hidden="true">
      {
        heroWordCloud.map((w) => (
          <span
            class:list={['absolute font-black tracking-tight whitespace-nowrap', w.size]}
            style={`top:${w.top}; left:${w.left}; transform:translate(-50%,-50%) rotate(${w.rotate}deg); opacity:${w.opacity}; color:${w.accent ? '#F5C518' : '#FFFFFF'};`}
          >
            {w.text}
          </span>
        ))
      }
    </div>

    <div class="relative z-10 mx-auto max-w-content px-4 py-24 md:px-6 md:py-32">
      <p class="mb-6 text-xs font-bold tracking-[0.25em] text-[#F5C518]">{d.heroEyebrow?.[fk] ?? ''}</p>
      <h1 class="max-w-5xl text-[2.8rem] font-black leading-[0.98] tracking-tight md:text-[4.6rem] lg:text-[5.6rem]">
        {d.heroTitle[fk]}
      </h1>
      <p class="mt-8 max-w-xl text-base leading-relaxed text-white/80 md:text-lg">
        {d.heroSubtitle?.[fk] ?? ''} {d.heroBody[fk]}
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={`/${locale}/about`}
          class="rounded-full bg-[#F5C518] px-6 py-3 text-sm font-bold text-thp-navy transition-colors hover:bg-[#D4A70F]"
        >
          {d.ctaPrimary[fk]}
        </a>
        <a
          href={`/${locale}/pipeline`}
          class="rounded-full border border-white/30 px-6 py-3 text-sm font-bold text-white transition-colors hover:border-white/60"
        >
          {d.ctaSecondary[fk]}
        </a>
      </div>
    </div>
  </section>

  {
    weeklyThemeActive && weeklyThemeItems.length === 3 ? (
      <section class="border-b border-thp-line bg-thp-mist">
        <div class="mx-auto max-w-content px-4 py-14 md:px-6 md:py-16">
          <div class="mb-2 flex flex-wrap items-center justify-between gap-3">
            <p class="text-xs font-bold tracking-widest text-thp-teal">{weeklyThemeCopy[locale].eyebrow}</p>
            <a href={`/${locale}/intelligence`} class="text-xs font-bold text-thp-ink/40 hover:text-thp-tealDeep">
              {latestSignalsMore} →
            </a>
          </div>
          <h2 class="mt-1 text-3xl font-black tracking-tight text-thp-navy2 md:text-4xl">{weeklyThemeCopy[locale].label}</h2>
          <p class="mt-1 text-sm font-bold text-thp-ink/40">{weeklyThemeCopy[locale].subLabel}</p>
          <p class="mt-4 max-w-2xl whitespace-pre-line text-base leading-relaxed text-thp-ink/70">{weeklyThemeCopy[locale].lead}</p>

          <!-- FEATURED -->
          <a
            href={`/${locale}/intelligence/${weeklyThemeItems[0].entry.id}`}
            class="mt-8 block rounded-2xl border border-thp-line bg-white p-6 transition-colors hover:border-thp-teal md:p-8"
          >
            <span class="rounded-full bg-thp-teal/10 px-2.5 py-1 text-[11px] font-bold tracking-widest text-thp-tealDeep">
              {weeklyThemeItems[0].tier[locale]}
            </span>
            <p class="mt-4 text-xl font-black leading-snug text-thp-navy2 md:text-2xl">{weeklyThemeItems[0].entry.data.title[fk]}</p>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-thp-ink/60">{weeklyThemeItems[0].entry.data.dek[fk]}</p>

            <!-- GLP-1 START → WEIGHT LOSS → GLP-1 STOP → REGAIN/MAINTENANCE 플로우 -->
            <div class="mt-6 flex flex-wrap items-center gap-2 rounded-xl border border-thp-line bg-thp-mist p-4 text-[11px] font-bold">
              <span class="rounded-full bg-white px-3 py-1.5 text-thp-navy2 shadow-sm">{glp1FlowLabels.start}</span>
              <span class="text-thp-ink/30">→</span>
              <span class="rounded-full bg-white px-3 py-1.5 text-thp-navy2 shadow-sm">{glp1FlowLabels.loss}</span>
              <span class="text-thp-ink/30">→</span>
              <span class="rounded-full bg-white px-3 py-1.5 text-thp-navy2 shadow-sm">{glp1FlowLabels.stop}</span>
              <span class="text-thp-ink/30">→</span>
              <span class="flex flex-col gap-1.5">
                <span class="rounded-full border border-thp-ink/15 bg-white px-3 py-1 text-thp-ink/40">{glp1FlowLabels.regain}</span>
                <span class="rounded-full bg-thp-teal px-3 py-1 text-white">{glp1FlowLabels.maintenance}</span>
              </span>
            </div>
          </a>

          <div class="mt-6 grid gap-6 lg:grid-cols-2">
            <!-- SCIENCE PICK -->
            <a
              href={`/${locale}/intelligence/${weeklyThemeItems[1].entry.id}`}
              class="block rounded-2xl border border-thp-line bg-white p-6 transition-colors hover:border-thp-teal"
            >
              <span class="rounded-full bg-thp-teal/10 px-2.5 py-1 text-[11px] font-bold tracking-widest text-thp-tealDeep">
                {weeklyThemeItems[1].tier[locale]}
              </span>
              <p class="mt-3 text-base font-extrabold leading-snug text-thp-navy2">{weeklyThemeItems[1].entry.data.title[fk]}</p>
              <p class="mt-2 text-sm leading-relaxed text-thp-ink/60">{weeklyThemeItems[1].entry.data.dek[fk]}</p>

              <!-- 장기별 회복상태 다이어그램: 추상적 인체 실루엣(사진 아님) + 확인된 조직만 표시 -->
              <div class="relative mx-auto mt-6 h-[220px] w-[140px]">
                <svg viewBox="0 0 140 220" class="absolute inset-0 h-full w-full" aria-hidden="true">
                  <circle cx="70" cy="26" r="20" fill="none" stroke="#CBD5E1" stroke-width="2" />
                  <rect x="38" y="48" width="64" height="100" rx="28" fill="none" stroke="#CBD5E1" stroke-width="2" />
                  <line x1="38" y1="150" x2="20" y2="210" stroke="#CBD5E1" stroke-width="2" />
                  <line x1="102" y1="150" x2="120" y2="210" stroke="#CBD5E1" stroke-width="2" />
                </svg>
                {
                  organItems.map((o) => (
                    <span
                      class:list={['absolute -translate-x-1/2 -translate-y-1/2 rounded-full', o.state === 'persistent' ? 'bg-thp-teal' : 'bg-[#DC2626]']}
                      style={`top:${o.top}; left:${o.left}; width:8px; height:8px;`}
                      title={`${o.organ}: ${o.status}`}
                    />
                  ))
                }
              </div>
              <p class="mt-3 text-center text-[11px] font-bold tracking-wide text-thp-ink/50">{organRecoveryLabel}</p>
              <div class="mt-3 flex flex-wrap justify-center gap-x-3 gap-y-1 text-[11px] text-thp-ink/50">
                {organItems.map((o) => <span>{o.organ} · {o.status}</span>)}
              </div>
              <p class="mt-2 text-center text-[11px] leading-relaxed text-thp-ink/40">{organRestNote}</p>
            </a>

            <!-- TECHNOLOGY WATCH -->
            <a
              href={`/${locale}/intelligence/${weeklyThemeItems[2].entry.id}`}
              class="block rounded-2xl border border-thp-line bg-white p-6 transition-colors hover:border-thp-teal"
            >
              <span class="rounded-full bg-thp-teal/10 px-2.5 py-1 text-[11px] font-bold tracking-widest text-thp-tealDeep">
                {weeklyThemeItems[2].tier[locale]}
              </span>
              <p class="mt-3 text-base font-extrabold leading-snug text-thp-navy2">{weeklyThemeItems[2].entry.data.title[fk]}</p>
              <p class="mt-2 text-sm leading-relaxed text-thp-ink/60">{weeklyThemeItems[2].entry.data.dek[fk]}</p>

              <!-- 3D ORGANOID → FUNCTION SENSOR → DATA → AI ANALYSIS → DRUG DECISION (정적 플로우) -->
              <div class="mt-6 flex flex-wrap items-center gap-1.5 text-[10px] font-bold">
                {
                  organoidSteps.map((s, i) => (
                    <>
                      <span class="rounded-lg border border-thp-line bg-thp-mist px-2.5 py-2 text-center text-thp-navy2">{s}</span>
                      {i < organoidSteps.length - 1 && <span class="text-thp-ink/30">→</span>}
                    </>
                  ))
                }
              </div>
            </a>
          </div>
        </div>
      </section>
    ) : (
      latestSignals.length > 0 && (
        <section class="border-b border-thp-line bg-thp-mist">
          <div class="mx-auto max-w-content px-4 py-10 md:px-6">
            <div class="mb-5 flex items-center justify-between">
              <p class="text-xs font-bold tracking-widest text-thp-teal">{latestSignalsLabel}</p>
              <a href={`/${locale}/intelligence`} class="text-xs font-bold text-thp-ink/40 hover:text-thp-tealDeep">
                {latestSignalsMore} →
              </a>
            </div>
            <div class="grid gap-3 sm:grid-cols-3">
              {latestSignals.map((item) => (
                <a
                  href={`/${locale}/intelligence/${item.id}`}
                  class="flex flex-col rounded-xl border border-thp-line bg-white p-4 transition-colors hover:border-thp-teal"
                >
                  <span class="text-[15px] font-bold tracking-wider text-thp-tealDeep">{item.data.publishedAt}</span>
                  <p class="mt-2 text-sm font-bold leading-snug text-thp-navy2 line-clamp-2">{item.data.title[fk]}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    )
  }

  <section class="border-b border-thp-line bg-white">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <p class="mb-3 text-xs font-bold tracking-widest text-thp-teal">{keyFocus.eyebrow}</p>
      <h2 class="mb-10 max-w-3xl text-3xl font-black leading-tight tracking-tight text-thp-navy2 md:text-5xl">
        {keyFocus.title}
      </h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          healthTopics.map((t) => {
            const accent = accentMap[t.data.slug] ?? '#EE7F1A';
            return (
              <a
                href={`/${locale}/health/${t.data.slug}`}
                class="group relative flex flex-col rounded-2xl border border-thp-line p-6 transition-all hover:-translate-y-1 hover:border-transparent hover:shadow-xl"
                style={`--tw-shadow-color:${accent}33`}
              >
                <div class="flex items-start justify-between">
                  <div
                    class="flex h-14 w-14 items-center justify-center rounded-2xl transition-transform group-hover:scale-105"
                    style={`background:${accent}16; color:${accent}`}
                  >
                    <HealthSectionIcon kind={iconKindMap[t.data.slug] ?? 'body'} class="h-7 w-7" />
                  </div>
                  <span class="text-lg text-thp-ink/20 transition-all group-hover:translate-x-1 group-hover:text-thp-tealDeep">→</span>
                </div>
                <p class="mt-5 text-sm font-extrabold text-thp-navy2">{t.data.title[fk]}</p>
                <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-thp-ink/55">{t.data.oneMinuteSummary[fk]}</p>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- 2026-08-14: "HOW WE WORK"을 문단 하나로 설명하던 것을, DRIVE 다섯 글자를 큼직한 타이포그래피로
       보여주는 방식으로 재구성 — 글자 자체가 비주얼이 되도록. 각 글자는 SCIENCE 하위 페이지로 링크.
       2026-08-21: 히어로(thp-navy, 딥브라운)와 색이 너무 비슷해 두 섹션이 하나로 붙어 보인다는
       피드백 — 배경을 thp-ink(더 어둡고 차분한 톤)로 바꿔 히어로와 시각적으로 구분되도록 하고,
       "DRIVE"라는 이름을 문단 속에 묻히지 않도록 독립된 라벨로 앞에 빼서 강조했다. -->
  <section class="bg-thp-ink text-white">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <p class="mb-3 text-xs font-bold tracking-widest text-white/50">HOW WE WORK</p>
      <p class="mb-4 text-2xl font-black tracking-tight text-[#F5C518] md:text-3xl">DRIVE</p>
      <p class="mb-10 max-w-2xl text-sm leading-relaxed text-white/65">{devEngineCopy[locale]}</p>

      <div class="grid grid-cols-2 gap-6 sm:grid-cols-5">
        {
          driveFramework.map((s) => (
            <a href={`/${locale}/science/${s.slug}`} class="group block">
              <p class="flex items-baseline gap-1 text-[3.5rem] font-black leading-none text-white transition-colors group-hover:text-[#F5C518] md:text-[4.5rem]">
                {s.letter}
                <span class="text-base font-bold text-white/0 transition-colors group-hover:text-[#F5C518]/70 md:text-lg">→</span>
              </p>
              <p class="mt-3 text-xs font-bold tracking-widest text-[#F5C518]">{s.stage}</p>
              <p class="mt-2 text-[13px] leading-relaxed text-white/55">{s.meaning[locale]}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
