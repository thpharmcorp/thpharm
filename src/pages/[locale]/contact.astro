---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanySubnav from '../../components/CompanySubnav.astro';
import { locales, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };

const copy = {
  kr: {
    title: '다음 대사질환 치료제를 함께 만들어갑니다.',
    body: '아래 문의 유형을 참고해 연락해 주세요. 회사 공식 연락처는 확인 후 게시됩니다.',
  },
  en: {
    title: "Let's create the next metabolic medicine.",
    body: 'Please reach out using the categories below. Official contact details will be published once confirmed.',
  },
  'zh-cn': {
    title: '共同创造下一代代谢性疾病治疗药物。',
    body: '请参考以下咨询类别与我们联系。官方联系方式将在确认后公布。',
  },
  jp: {
    title: '次の代謝性疾患治療薬を共に作りましょう。',
    body: '以下の問い合わせ種別を参考にご連絡ください。公式連絡先は確認後に掲載されます。',
  },
} as const;
const t = copy[locale];

const inquiryTypes = [
  { kr: 'Drug Development', body: { kr: '공동개발 / Licensing / 제형·복합제 협력', en: 'Co-development / licensing / formulation & combination collaboration', 'zh-cn': '联合开发 / 授权 / 剂型与复方合作', jp: '共同開発 / ライセンス / 剤形・配合剤協力' } },
  { kr: 'Bio-AI Collaboration', body: { kr: 'AI / Data / Biomarker / 질환 네트워크 협력', en: 'AI / data / biomarker / disease network collaboration', 'zh-cn': 'AI / 数据 / 生物标志物 / 疾病网络合作', jp: 'AI / データ / バイオマーカー / 疾患ネットワーク協力' } },
  { kr: 'Clinical Partnership', body: { kr: '임상개발 / CRO / 병원 / Site 협력', en: 'Clinical development / CRO / hospital / site collaboration', 'zh-cn': '临床开发 / CRO / 医院 / 研究机构合作', jp: '臨床開発 / CRO / 病院 / サイト協力' } },
  { kr: 'Technology Partnership', body: { kr: 'Bioprinting / Biofabrication / 연구기술', en: 'Bioprinting / biofabrication / research technology', 'zh-cn': '生物打印 / 生物制造 / 研究技术', jp: 'バイオプリンティング / バイオファブリケーション / 研究技術' } },
  { kr: 'Investment / IR', body: { kr: '투자 / IR / 기관 문의', en: 'Investment / IR / institutional inquiries', 'zh-cn': '投资 / IR / 机构咨询', jp: '投資 / IR / 機関からのお問い合わせ' } },
];
---

<BaseLayout locale={locale} title={t.title} description={t.body}>
  <CompanySubnav locale={locale} current="contact" />
  <section class="bg-white">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <p class="text-xs font-bold tracking-widest text-thp-teal">CONTACT</p>
      <h1 class="mt-3 max-w-2xl text-3xl font-black tracking-tight text-thp-navy2 md:text-4xl">{t.title}</h1>
      <p class="mt-4 max-w-xl text-thp-ink/70">{t.body}</p>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {
          inquiryTypes.map((i) => (
            <div class="rounded-2xl border border-thp-line p-6">
              <p class="text-sm font-bold text-thp-navy2">{i.kr}</p>
              <p class="mt-2 text-sm text-thp-ink/60">{i.body[locale]}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10 rounded-2xl bg-thp-mist p-6 text-sm text-thp-ink/60">
        [회사 자료 확인 필요] 대표 이메일 / 전화 / 주소 — Footer 및 이 페이지에 함께 표기됩니다.
      </div>
    </div>
  </section>
</BaseLayout>
