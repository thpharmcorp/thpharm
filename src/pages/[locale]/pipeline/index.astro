---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroDark from '../../../components/HeroDark.astro';
import { locales, localeToFieldKey, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const fk = localeToFieldKey[locale];

const assets = await getCollection('pipeline');

// 2026-08-14 재작성: 기존 카피("아이디어를 실제 치료제로 만들어갑니다" + "개량신약과 복합제
// 개발 경험에서 출발해 ... 확장되고 있습니다")는 동어반복이라는 피드백 — 파이프라인 페이지가
// 왜 존재하는지(무엇에 공을 들이는지)를 구체적으로 보여주도록 다시 썼다. WEB-503 논문 카드에서
// 다룬 "복합제가 순응도를 높인다"는 실제 최신 근거를 그대로 연결한다(Diabetes Therapy 2026).
const heroCopy = {
  kr: {
    eyebrow: 'PIPELINE',
    title: '알약 하나를 줄이는 것이, 치료의 시작입니다.',
    body: '효과만큼 중요한 건 환자가 그 약을 실제로 계속 먹을 수 있는가입니다. 티에치팜은 이미 안전성이 검증된 약들을 다시 조합하고, Bio-AI로 최적의 짝을 찾아, 오래 복용할 수 있는 치료제를 만드는 데 집중합니다.',
  },
  en: {
    eyebrow: 'PIPELINE',
    title: 'Removing one pill is where treatment begins.',
    body: 'Efficacy alone isn’t enough if patients can’t keep taking the medicine. We recombine drugs whose safety is already proven, use Bio-AI to find the best pairing, and focus on treatments people can actually stay on.',
  },
  'zh-cn': {
    eyebrow: 'PIPELINE',
    title: '减少一颗药,就是治疗的开始。',
    body: '疗效固然重要,但患者能否真正坚持服药同样关键。THPHARM重新组合已被验证安全性的药物,借助Bio-AI寻找最佳配伍,专注于打造患者能够长期坚持服用的治疗药物。',
  },
  jp: {
    eyebrow: 'PIPELINE',
    title: '錠剤を一つ減らすことが、治療の始まりです。',
    body: '効果と同じくらい重要なのは、患者さんが実際にその薬を飲み続けられるかどうかです。THPHARMはすでに安全性が確認された薬を組み合わせ直し、Bio-AIで最適な組み合わせを探し、長く服用し続けられる治療薬づくりに力を注いでいます。',
  },
} as const;
const hero = heroCopy[locale];

// 기존 tags(THP-001/THP-004/GLOBAL PHASE 3/GLP-1 · MASH)는 이 위치에서 의미 없다는 피드백 —
// 자산 코드 나열 대신, 티에치팜의 실제 개발 방법론을 보여주는 키워드로 교체.
const heroTags = ['DRUG REPURPOSING', 'FIXED-DOSE COMBINATION', 'BIO-AI-GUIDED'];

// 2026-08-21: 페이지마다 같은 세포 이미지를 재활용하던 걸 페이지별 워드클라우드로 교체(HeroDark 참고).
// PIPELINE은 실제 자산 코드·개발 단계·개발 방법론 키워드로 구성(과장/추정 없이 실제 콘텐츠 기준).
const heroWordCloud = [
  { text: 'THP-001', top: '10%', left: '76%', size: 'text-xl md:text-3xl', rotate: -3, opacity: 0.14, accent: true },
  { text: 'PHASE 3', top: '4%', left: '30%', size: 'text-lg md:text-2xl', rotate: 3, opacity: 0.1 },
  { text: 'THP-004', top: '30%', left: '90%', size: 'text-lg md:text-2xl', rotate: 4, opacity: 0.1 },
  { text: 'PRECLINICAL', top: '22%', left: '14%', size: 'text-base md:text-xl', rotate: -2, opacity: 0.08 },
  { text: 'DRUG REPURPOSING', top: '52%', left: '70%', size: 'text-lg md:text-2xl', rotate: -3, opacity: 0.12 },
  { text: 'FIXED-DOSE COMBINATION', top: '68%', left: '30%', size: 'text-sm md:text-lg', rotate: 2, opacity: 0.08 },
  { text: 'BIO-AI-GUIDED', top: '80%', left: '72%', size: 'text-lg md:text-2xl', rotate: -2, opacity: 0.14, accent: true },
  { text: '복합제', top: '46%', left: '10%', size: 'text-base md:text-lg', rotate: 3, opacity: 0.08 },
  { text: 'ORAL', top: '86%', left: '20%', size: 'text-base md:text-lg', rotate: -4, opacity: 0.07 },
];

const stageOrder = ['Discovery', 'Preclinical', 'Phase 1', 'Phase 2', 'Phase 3', 'Regulatory'];

const overviewCopy: Record<Locale, { title: string }> = {
  kr: { title: 'PIPELINE OVERVIEW' },
  en: { title: 'PIPELINE OVERVIEW' },
  'zh-cn': { title: 'PIPELINE OVERVIEW' },
  jp: { title: 'PIPELINE OVERVIEW' },
};
const overview = overviewCopy[locale];
---

<BaseLayout locale={locale} title={hero.title} description={hero.body}>
  <HeroDark
    eyebrow={hero.eyebrow}
    title={hero.title}
    body={hero.body}
    tags={heroTags}
    wordCloud={heroWordCloud}
  />

  <section class="bg-white">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <p class="mb-8 text-xs font-bold tracking-widest text-thp-teal">{overview.title}</p>

      <div
        class="mb-2 hidden gap-2 px-6 md:grid"
        style="grid-template-columns: 200px repeat(6, 1fr);"
      >
        <div />
        {stageOrder.map((s) => <p class="text-center text-[15px] font-bold uppercase tracking-wide text-thp-ink/35">{s}</p>)}
      </div>

      <div class="divide-y divide-thp-line rounded-2xl border border-thp-line">
        {
          assets.map((a) => {
            const idx = stageOrder.indexOf(a.data.stage);
            const pct = idx >= 0 ? (idx / (stageOrder.length - 1)) * 100 : 0;
            return (
              <a
                href={`/${locale}/pipeline/${a.id}`}
                class="grid gap-4 p-6 transition-colors hover:bg-thp-mist md:grid-cols-[200px_1fr] md:items-center"
              >
                <div>
                  <p class="text-lg font-extrabold text-thp-navy2">{a.data.assetId}</p>
                  <p class="mt-1 text-sm text-thp-ink/60">{a.data.indication[fk]}</p>
                  <div class="mt-2 flex items-center gap-2">
                    <span class="rounded-full bg-thp-teal/10 px-3 py-1 text-xs font-bold text-thp-tealDeep">{a.data.stage}</span>
                  </div>
                </div>
                <div class="relative hidden h-4 md:block">
                  <div class="absolute left-0 right-0 top-1/2 h-0.5 -translate-y-1/2 bg-thp-line" />
                  <div class="absolute left-0 top-1/2 h-0.5 -translate-y-1/2 bg-thp-teal" style={`width:${pct}%`} />
                  {stageOrder.map((s, i) => (
                    <div
                      class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 bg-white"
                      style={`left:${(i / (stageOrder.length - 1)) * 100}%; ${i <= idx ? 'border-color:#EE7F1A; background:#EE7F1A;' : 'border-color:#E2E8F0;'} ${i === idx ? 'box-shadow:0 0 0 4px rgba(238,127,26,0.18);' : ''} width:${i === idx ? '12px' : '8px'}; height:${i === idx ? '12px' : '8px'};`}
                    />
                  ))}
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>
