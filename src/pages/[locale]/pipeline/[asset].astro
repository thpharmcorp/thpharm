---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, localeToFieldKey, ui, driveFramework, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const assets = await getCollection('pipeline');
  return locales.flatMap((locale) =>
    assets.map((a) => ({ params: { locale, asset: a.id }, props: { entry: a } }))
  );
}

const { locale } = Astro.params as { locale: Locale };
const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'pipeline'>>>[number] };
const fk = localeToFieldKey[locale];
const strings = ui[locale];
const d = entry.data;

// 2026-08-21: 각 파이프라인 자산과 실제로 관련된 INTELLIGENCE 항목을 이 페이지에서 바로 보여준다
// (수동 큐레이션 — CLAUDE.md 원칙대로 자동 태그 매칭이 아니라 대표 확인 후 직접 지정).
// 예: THP-001(Phase 3)에 적용된 AI 역설계(Reverse Engineering) 전략 보도.
// 2026-08-25: 대표가 검토·승인한 논문 100선 순위매김 중 2·3위 항목 반영 — 2위(Aleniglipron 경구
// GLP-1 Phase 2b)는 같은 경구 GLP-1RA 계열인 THP-004에, 3위(약물 병용이 재창출 역가 한계를
// 극복한다는 리뷰)는 SGLT2i+ARB 재조합 전략인 THP-001에 연결한다.
// 2026-08-25: 언론 조사로 확인한 THPHARM 자체 연혁 뉴스 5건도 각 자산에 연결 — THP-001은
// 국전약품 MOU·임상1상 투약완료·경쟁사 구도, THP-004는 TIPS 선정·Dt&CRO MOU.
const relatedIntelligenceByAsset: Record<string, string[]> = {
  'THP-001': [
    'news-insilico-reverse-engineering',
    'web-503-fdc-adherence',
    'paper-drug-repositioning-combination-therapy',
    'news-kookjeon-mou-thp001',
    'news-thp001-phase1-dosing-complete',
    'news-fdc-competitive-landscape',
  ],
  'THP-004': [
    'paper-aleniglipron-oral-glp1-phase2b',
    'news-thp004-tips-selected',
    'news-dtncro-oral-glp1-mou',
  ],
};
const relatedIntelligenceLabel = { kr: '관련 INTELLIGENCE', en: 'Related Intelligence', 'zh-cn': '相关 Intelligence', jp: '関連 Intelligence' }[locale];
const relatedIntelligence = (
  await Promise.all((relatedIntelligenceByAsset[d.assetId] ?? []).map((id) => getEntry('intelligence', id)))
).filter((e): e is NonNullable<typeof e> => e !== undefined);

// 2026-08-13: 배지가 "REVEAL"/"INTERPRET"처럼 단계 동사만 덜렁 보여줘서 방문자가 뜻을 알 수
// 없던 문제 — driveFramework에서 역량명을 함께 찾아와 "REVEAL · Bio-AI"처럼 짝지어 보여주고,
// 각 배지를 해당 사이언스 하위 페이지로 링크한다.
const appliedStages = d.driveStagesApplied
  .map((s) => driveFramework.find((f) => f.stage === s))
  .filter((f): f is NonNullable<typeof f> => f !== undefined);
---

<BaseLayout locale={locale} title={`${d.assetId} — ${d.heroTagline[fk]}`} description={d.heroTagline[fk]}>
  <section class="bg-thp-navy text-white">
    <div class="mx-auto max-w-content px-4 py-16 md:px-6 md:py-20">
      <p class="mb-4 text-xs font-bold tracking-widest text-thp-teal">{d.assetId}</p>
      <h1 class="max-w-2xl text-3xl font-black tracking-tight md:text-4xl">{d.heroTagline[fk]}</h1>
      <p class="mt-4 text-white/70">{d.indication[fk]}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <span class="rounded-full bg-thp-teal px-4 py-1.5 text-xs font-bold text-white">{d.stage}</span>
      </div>
      <div class="mt-6">
        <div class="flex flex-wrap gap-2">
          {
            appliedStages.map((s) => (
              <a
                href={`/${locale}/science/${s!.slug}`}
                class="rounded-full border border-white/25 px-3 py-1.5 text-xs font-bold text-white/80 transition-colors hover:border-thp-teal hover:text-thp-teal"
              >
                {s!.stage} <span class="font-semibold text-white/50">· {s!.capability}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-content gap-10 px-4 py-16 md:grid-cols-2 md:px-6 md:py-20">
      <div>
        <p class="text-xs font-bold tracking-widest text-thp-teal">UNMET NEED</p>
        <p class="mt-3 text-sm leading-relaxed text-thp-ink/80">{d.unmetNeed[fk]}</p>
      </div>
      <div>
        <p class="text-xs font-bold tracking-widest text-thp-teal">OUR APPROACH</p>
        <p class="mt-3 text-sm leading-relaxed text-thp-ink/80">{d.approach[fk]}</p>
      </div>
      <div>
        <p class="text-xs font-bold tracking-widest text-thp-teal">DIFFERENTIATION</p>
        <p class="mt-3 text-sm leading-relaxed text-thp-ink/80">{d.differentiation[fk]}</p>
      </div>
      <div>
        <p class="text-xs font-bold tracking-widest text-thp-teal">NEXT MILESTONE</p>
        <p class="mt-3 text-sm leading-relaxed text-thp-ink/80">{d.nextMilestone[fk]}</p>
      </div>
    </div>
  </section>

  {
    relatedIntelligence.length > 0 && (
      <section class="border-t border-thp-line bg-white">
        <div class="mx-auto max-w-content px-4 py-14 md:px-6 md:py-16">
          <p class="mb-5 text-xs font-bold tracking-widest text-thp-teal">{relatedIntelligenceLabel}</p>
          <div class="grid gap-4 md:grid-cols-2">
            {relatedIntelligence.map((item) => (
              <a
                href={`/${locale}/intelligence/${item.id}`}
                class="block rounded-2xl border border-thp-line p-6 transition-colors hover:border-thp-teal"
              >
                <span class="text-[15px] font-bold tracking-wider text-thp-tealDeep">{item.data.publishedAt}</span>
                <p class="mt-2 text-base font-extrabold leading-snug text-thp-navy2">{item.data.title[fk]}</p>
                <p class="mt-2 text-sm leading-relaxed text-thp-ink/60">{item.data.dek[fk]}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="border-t border-thp-line bg-thp-mist">
    <div class="mx-auto max-w-content px-4 py-6 text-[12px] text-thp-ink/40 md:px-6">
      <p>
        {strings.source}: {d.sourceMeta?.source_title} · {strings.lastUpdated}: {d.lastUpdated}
      </p>
    </div>
  </section>
</BaseLayout>
