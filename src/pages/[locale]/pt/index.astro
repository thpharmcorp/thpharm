---
import { getEntry, getCollection } from 'astro:content';
import { locales, localeToFieldKey, type Locale } from '../../../i18n/ui';
import '../../../styles/global.css';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const fk = localeToFieldKey[locale];

const company = await getEntry('company-landing', 'web-100');
const science = await getEntry('science-landing', 'web-200');
const pipeline = await getCollection('pipeline');
if (!company || !science) throw new Error('PT Mode: WEB-100/WEB-200 콘텐츠가 필요합니다.');

const thp001 = pipeline.find((p) => p.data.assetId === 'THP-001');

const slides = [
  {
    eyebrow: 'COMPANY',
    title: company.data.heroTitle[fk],
    body: company.data.heroBody[fk],
  },
  {
    eyebrow: 'SCIENCE — DRIVE',
    title: science.data.heroTitle[fk],
    body: science.data.driveStages.map((s) => `${s.letter} · ${s.stage}`).join('   →   '),
  },
  {
    eyebrow: 'PIPELINE',
    title: thp001 ? thp001.data.heroTagline[fk] : '[COMPANY DATA NEEDED]',
    body: thp001 ? `${thp001.data.assetId} · ${thp001.data.indication[fk]} · ${thp001.data.stage}` : '',
  },
  {
    eyebrow: 'IR & PARTNERING',
    title: locale === 'kr' ? '대사질환 치료제를 실제 개발·임상·사업화로 연결합니다.' : 'Connecting metabolic disease R&D to real clinical development and commercialization.',
    body: '[COMPANY DATA NEEDED] Financial & Operating Highlights',
  },
];
---

<!doctype html>
<html lang={locale === 'zh-cn' ? 'zh-CN' : locale === 'jp' ? 'ja' : locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>THPHARM — PT MODE</title>
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="bg-thp-navy text-white font-sans">
    <div id="pt-root" class="relative flex h-screen w-screen flex-col justify-center overflow-hidden px-10 md:px-24">
      <a href={`/${locale}`} class="absolute left-6 top-6 text-xs font-semibold text-white/40 hover:text-white">✕ EXIT</a>
      <p class="pt-eyebrow text-xs font-bold tracking-[0.25em] text-thp-teal"></p>
      <h1 class="pt-title mt-6 max-w-4xl text-3xl font-black leading-tight md:text-5xl"></h1>
      <p class="pt-body mt-6 max-w-2xl text-base text-white/70 md:text-lg"></p>

      <div class="absolute bottom-8 left-10 flex items-center gap-4 md:left-24">
        <button id="pt-prev" class="rounded-full border border-white/25 px-4 py-2 text-xs font-bold hover:border-white/60">← PREV</button>
        <span id="pt-counter" class="text-xs text-white/40"></span>
        <button id="pt-next" class="rounded-full border border-white/25 px-4 py-2 text-xs font-bold hover:border-white/60">NEXT →</button>
      </div>
    </div>

    <script define:vars={{ slides }}>
      // define:vars는 is:inline으로 처리되어 TS 문법을 지원하지 않으므로 순수 JS만 사용합니다.
      let i = 0;
      const eyebrowEl = document.querySelector('.pt-eyebrow');
      const titleEl = document.querySelector('.pt-title');
      const bodyEl = document.querySelector('.pt-body');
      const counterEl = document.getElementById('pt-counter');
      const nextBtn = document.getElementById('pt-next');
      const prevBtn = document.getElementById('pt-prev');

      function render() {
        const s = slides[i];
        if (eyebrowEl) eyebrowEl.textContent = s.eyebrow;
        if (titleEl) titleEl.textContent = s.title;
        if (bodyEl) bodyEl.textContent = s.body;
        if (counterEl) counterEl.textContent = (i + 1) + ' / ' + slides.length;
      }
      nextBtn?.addEventListener('click', () => {
        i = Math.min(i + 1, slides.length - 1);
        render();
      });
      prevBtn?.addEventListener('click', () => {
        i = Math.max(i - 1, 0);
        render();
      });
      window.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') nextBtn?.click();
        if (e.key === 'ArrowLeft') prevBtn?.click();
      });
      render();
    </script>
  </body>
</html>
